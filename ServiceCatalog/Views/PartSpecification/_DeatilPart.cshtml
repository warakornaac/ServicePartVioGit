
@if (ViewBag.ListProductApiCount.Count == 0)
{
    <div class="alert alert-danger text-center" style="font-size: 16px; font-weight: bold;">
        <i class="fa fa-exclamation-triangle" aria-hidden="true"></i> ไม่พบข้อมูล
    </div>
}
else
{
    <div class="row">
        <div class="col-xl-12">
            <div class="card custom-card">
                <div class="card-header d-md-flex d-block">
                    <div class="h5 mb-0 d-sm-flex d-bllock align-items-center">
                        <div class="ms-sm-2 ms-0 mt-sm-0 mt-2">
                            <div class="h6 fw-semibold mb-0">
                                <a aria-label="anchor" href="#" class="header-link switcher-icon" data-bs-toggle="offcanvas" data-bs-target="#switcher-canvas"> <i class="bx bx-cog header-link-icon"></i> </a>
                                <span class="text-primary">@ViewBag.ListProductApiCount[0].Stkdes</span>
                            </div>
                        </div>
                    </div>
                    @*<div class="ms-auto mt-md-0 mt-2">
                            <button class="btn btn-sm btn-secondary me-1" onclick="javascript:window.print();">Print<i class="ri-printer-line ms-1 align-middle d-inline-block"></i></button>
                            <button class="btn btn-sm btn-primary">Save As PDF<i class="ri-file-pdf-line ms-1 align-middle d-inline-block"></i></button>
                        </div>*@
                </div>
                <div class="card-body">
                    <div class="row gy-3">
                        <div class="col-xl-3">
                            <div class="fs-14 text-muted">
                                <span class="me-2 text-default fw-semibold"> Brand : </span>
                                @ViewBag.ListProductApiCount[0].BrandName
                            </div>
                        </div>
                        <div class="col-xl-3">
                            <span class="me-2 text-default fw-semibold"> Api Status : </span>
                            @{
                                string txtStatus = string.Empty;
                                string colorStatus = string.Empty;
                                string iconBtnStatus = string.Empty;
                                if (ViewBag.ListProductApiCount[0].ApiStatus == "Y")
                                {
                                    txtStatus = "Complete";
                                    colorStatus = "success";
                                    iconBtnStatus = "<i class='ri-eye-line'></i>";
                                }
                                else if (ViewBag.ListProductApiCount[0].ApiStatus == "D")
                                {
                                    txtStatus = "In Progress";
                                    colorStatus = "warning";
                                    iconBtnStatus = "<i class='spinner-grow spinner-grow-sm align-middle' aria-hidden='true'></i>";
                                }
                                else
                                {
                                    txtStatus = "Pending";
                                    colorStatus = "warning";
                                    iconBtnStatus = "<i class='ri-lock-fill'></i>";
                                }
                            }
                            <span class="badge bg-@colorStatus-transparent">@txtStatus</span>
                        </div>
                        <div class="col-xl-3">
                            <div class="fs-14 text-muted">
                                <span class="me-2 text-default fw-semibold"> Api Call Date : </span>
                                @if (ViewBag.ListProductApiCount[0].ApiCallDate.Contains("01/01/1900"))
                                {
                                    @:-
                                }
                                else
                                {
                                    @ViewBag.ListProductApiCount[0].ApiCallDate
                                }
                            </div>
                        </div>
                        @*Start tab*@
                        <div class="row pt-3 pl-2">
                            <div class="col-xl-12">
                                <div class="card custom-card border rounded p-2">
                                    <ul class="nav nav-tabs mb-3" role="tablist">
                                        <li class="nav-item">
                                            <a class="nav-link active" data-bs-toggle="tab" role="tab" href="#tabDescription" aria-selected="true">
                                                Description
                                                <span class="badge bg-secondary rounded-pill fs-14" id="rowDescription"> @ViewBag.ListProductApiCount[0].countProductDes </span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" data-bs-toggle="tab" role="tab" href="#tabSpec" aria-selected="false">
                                                Spec
                                                <span class="badge bg-secondary rounded-pill fs-14" id="rowSpec"> @ViewBag.ListProductApiCount[0].countProductSpec </span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" data-bs-toggle="tab" role="tab" href="#tabImage" aria-selected="false">
                                                Image
                                                <span class="badge bg-secondary rounded-pill fs-14" id="rowImage"> @ViewBag.ListProductApiCount[0].countProductImage </span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" data-bs-toggle="tab" role="tab" href="#tabOem" aria-selected="false">
                                                Oem
                                                <span class="badge bg-secondary mt rounded-pill fs-14" id="rowOem"> @ViewBag.ListProductApiCount[0].countProductOem </span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" data-bs-toggle="tab" role="tab" href="#tabCompetitor" aria-selected="false">
                                                Competitor
                                                <span class="badge bg-secondary mt rounded-pill fs-14" id="rowCompetitor"> @ViewBag.ListProductApiCount[0].countProductCom </span>
                                            </a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" data-bs-toggle="tab" role="tab" href="#tabLinkage" aria-selected="false">
                                                Vehicle linkage
                                                <span class="badge bg-secondary mt rounded-pill fs-14" id="rowLinkage"> @ViewBag.ListProductApiCount[0].countProductLinkage </span>
                                            </a>
                                        </li>
                                    </ul>
                                    <div class="tab-content">
                                        <div class="tab-pane show active text-muted" id="tabDescription" role="tabpanel"> </div>
                                        <div class="tab-pane text-muted" id="tabSpec" role="tabpanel"> </div>
                                        <div class="tab-pane text-muted" id="tabImage" role="tabpanel"> </div>
                                        <div class="tab-pane text-muted" id="tabOem" role="tabpanel"> </div>
                                        <div class="tab-pane text-muted" id="tabCompetitor" role="tabpanel"> </div>
                                        <div class="tab-pane text-muted" id="tabLinkage" role="tabpanel"> </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @*End tab*@
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal Add&Update Description-->
<div class="modal fade" id="DescriptionAddModal" tabindex="-1" aria-labelledby="ModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header pb-2">
                <h4 class="modal-title" id="ModalLabel"> <i class="ri-add-box-fill"></i> Add Description </h4>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-2">
                        <label for="form-text" class="form-label fs-14 text-dark"> Row : <u><span class="text-danger fw-semibold fs-16" id="labelRow"> </span></u> </label>
                        <input type="hidden" class="form-control" id="txtRow" placeholder="Row" readonly>
                        <input type="hidden" class="form-control" id="txtFlag">
                    </div>
