<script defer>
    function checkPartImage() {
        LoadingShow();
        const url = $('#ImageAddModal #txtDescription').val();
        if (!url) {
            $("#ImageAddModal #divPreviewImage").css('display', 'none');
            LoadingHide();
            Swal.fire({
                icon: 'warning',
                title: 'Empty URL',
                text: 'Please enter an image URL before checking.',
            });
            return;
        }
        // Create a new image to test
        const img = new Image();
        img.onload = function () {
            LoadingHide();
            // Image loaded successfully
            $("#ImageAddModal #divPreviewImage").css('display', 'block');
            $('#ImageAddModal #previewImage').attr('src', url).show();
        };
        img.onerror = function () {
            $("#ImageAddModal #divPreviewImage").css('display', 'none');
            LoadingHide();
            Swal.fire({
                icon: 'error',
                title: 'Invalid Image URL',
                text: 'The image does not exist or the URL is incorrect.',
            });
        };
        img.src = url;
    }
    //delete part spec by stkcode
    function deletePartSpecByStkcode(tableName, txtSeq) {
        let stockCodeSearch = $("#stockCodeSearch").val();
        Swal.fire({
            icon: 'question',
            title: 'ต้องการลบใช่หรือไม่?',
            html: '',
            confirmButtonColor: '#3085d6',
            confirmButtonText: 'ใช่',
            showCancelButton: true,
            cancelButtonColor: '#d33',
            cancelButtonText: 'ไม่ใช่',
            allowOutsideClick: false,
            focusConfirm: false,
        }).then(async (result) => {
            if (result.value) {
                 $.ajax({
                    url: '@Url.Action("deletePartByStkcode", "PartSpecification")',
                    type: 'post',
                     data: {
                         tableName: 'Product_' + tableName,
                         stkcode: stockCodeSearch,
                         seq: txtSeq,
                     },
                    dataType: 'json',
                    beforeSend: function () {
                        LoadingShow();
                    },
                    success: function (result) {
                        console.log("result.status = " + result.status);
                        if (result.status == "success") {
                            LoadingHide();
                            Swal.fire({
                                title: 'Deleted successfully',
                                icon: 'success',
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'Close',
                                allowOutsideClick: false,
                                focusConfirm: false,
                                timer: 5000,
                                timerProgressBar: true,
                                didClose: () => {
                                    setTimeout(function () {
                                        $('#' + tableName + 'AddModal').removeClass('show').removeAttr('aria-modal').css('display', 'none');
                                        $('body').removeClass('modal-open');
                                        $('.modal-backdrop').remove();
                                        //refresh list by tab
                                        getListDetailPartByStkcode("tab" + tableName);
                                        updateNumberRowByTab("delete", tableName);
                                    }, 500);
                                }
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'ระบบทำงานผิดพลาด',
                                html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้ deletePartByStkcode.<br> ' + result.message + '<br><br>',
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'ปิด | Close',
                                allowOutsideClick: false,
                                focusConfirm: false,
                            });
                        }
                    },
                    complete: function () {
                        LoadingHide();
                    },
                }).fail(function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ระบบทำงานผิดพลาด',
                        html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้ deletePartByStkcode.<br> ' + error + '<br><br>',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด | Close',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                });
            }
        });
    }
    //update Num row by tab
    function updateNumberRowByTab(flag, tabName) {
        if (flag != "" && tabName != "") {
            const rowId = '#row' + tabName;
            let newCount = 0;
            let currentCount = parseInt($(rowId).text()) || 0;
            if (flag == "add") {
                newCount = currentCount + 1
            } else if (flag == "delete") {
                newCount = currentCount - 1;
            } else {
                newCount = currentCount;
            }
            newCount = Math.max(0, newCount);
            $(rowId).text(newCount);
        }
    }
    //save Description
    function savePartDescription(tabName) {
        var modalAddName = "";
        modalAddName = tabName + "AddModal";
        let txtSeq = $('#' + modalAddName + ' #txtRow').val();
        let txtTitle = $('#' + modalAddName + ' #txtTitle').val();
        let txtDescription = $('#' + modalAddName + ' #txtDescription').val();
        let txtFlag = $('#' + modalAddName + ' #txtFlag').val();
        let stockCodeSearch = $("#stockCodeSearch").val();
        let Error = 0;
        let TextMsg = "";
        if (txtDescription == "") {
            Error++;
            TextMsg += Error + '. กรุณากรอกข้อมูล Description.<br/>';
        }
        console.log("savePartDescription txtFlag = " + txtFlag);
        if (Error > 0) {
            Swal.fire({
                icon: 'warning',
                title: 'กรุณาตรวจสอบข้อมูลดังต่อไปนี้ ',
                html: '<div class="text-left">' + TextMsg + '</div>',
            });
            return false;
        }
        Swal.fire({
            icon: 'question',
            title: 'ต้องการบันทึกใช่หรือไม่?',
            html: '',
            confirmButtonColor: '#3085d6',
            confirmButtonText: 'ใช่',
            showCancelButton: true,
            cancelButtonColor: '#d33',
            cancelButtonText: 'ไม่ใช่',
            allowOutsideClick: false,
            focusConfirm: false,
        }).then(async (result) => {
            if (result.value) {
                 $.ajax({
                    url: '@Url.Action("savePartDescription", "PartSpecification")',
                    type: 'post',
                     data: {
                         tableName: 'Product_' + tabName,
                         stkcode: stockCodeSearch,
                         seq: txtSeq,
                         title: txtTitle,
                         description: txtDescription,
                         userName: 'Product Team'
                     },
                    dataType: 'json',
                    beforeSend: function () {
                        LoadingShow();
                    },
                    success: function (result) {
                        console.log("result.status = " + result.status);
                        if (result.status == "success") {
                            LoadingHide();
                            Swal.fire({
                                title: 'Saved successfully',
                                icon: 'success',
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'Close',
                                allowOutsideClick: false,
                                focusConfirm: false,
                                timer: 5000,
                                timerProgressBar: true,
                                didClose: () => {
                                    setTimeout(function () {
                                        $('#' + modalAddName).removeClass('show').removeAttr('aria-modal').css('display', 'none');
                                        $('body').removeClass('modal-open');
                                        $('.modal-backdrop').remove();
                                        getListDetailPartByStkcode("tab" + tabName);
                                        updateNumberRowByTab(txtFlag, tabName);
                                    }, 500);
                                }
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'ระบบทำงานผิดพลาด',
                                html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้ savePartDescription.<br> ' + result.message + '<br><br>',
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'ปิด | Close',
                                allowOutsideClick: false,
                                focusConfirm: false,
                            });
                        }
                    },
                    complete: function () {
                        LoadingHide();
                    },
                }).fail(function (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'ระบบทำงานผิดพลาด',
                        html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้ savePartDescription.<br> ' + error + '<br><br>',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด | Close',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                });
            }
        });
    }
    //get modal by tab
    function getModalAddByTab(flag, tabName, txtRow, txtTitle, txtDescription) {
        LoadingShow();
        var modalAddName = "";
        const tagOlByTab = document.getElementById('ol' + tabName);
        let countTagOlByTab = 0;
        let countByFlag = 0;

        if (tagOlByTab) {
            countTagOlByTab = tagOlByTab.querySelectorAll('li').length;
        } else {
            console.warn(`Element with id 'ol${tabName}' not found. Defaulting to 0 rows.`);
        }
        //ถ้า Flag = add +1
        if (flag == "add") {
            txtRow = countTagOlByTab + 1;
            $("#ImageAddModal #divPreviewImage").css('display', 'none');
        } else {
            txtRow = txtRow;
        }
        if (tabName !== "") {
            modalAddName = tabName + "AddModal";
        }
        const modalEl = document.getElementById(modalAddName);
        if (!modalEl) {
            console.error(`Modal with id '${modalAddName}' not found.`);
            LoadingHide();
            return;
        }
        var modal = new bootstrap.Modal(modalEl);
        modal.show();

        console.log("txtRow = " + txtRow);

        setTimeout(function () {
            LoadingHide();
            $('#' + modalAddName + ' #txtTitle').focus();
            //update get value to textbox
            $('#' + modalAddName + ' #txtFlag').val(flag);
            $('#' + modalAddName + ' #txtRow').val(txtRow);
            $('#' + modalAddName + ' #labelRow').html(txtRow);

            $('#' + modalAddName + ' #txtTitle').val(txtTitle);
            $('#' + modalAddName + ' #txtDescription').val(txtDescription);
        }, 500);
    }
    //default ดึงข้อมูล tab แรก
    $(document).ready(function () {
        getListDetailPartByStkcode("tabDescription");
    });
    //ดึงข้อมูลแต่ละ Tab
    function getListDetailPartByStkcode(tabName) {
        console.log("tabName = " + tabName);
        var stockCodeSearch = $('#stockCodeSearch').val();
        $.ajax({
            type: 'post',
            url: '@Url.Action("getListDetailPartByTab", "PartSpecification")',
            data: {
                tabName: tabName,
                stkcode: stockCodeSearch
            },
            dataType: 'html',
            cache: false,
            Async: true,
            beforeSend: function () {
                $('#' + tabName).empty();
                $('#' + tabName).html('<div style="padding: 30px; font-size: 14px;"> <i class="fa fa-spinner fa-spin fa-2x" aria-hidden="true"></i> กำลังโหลดข้อมูล... </div>');
                // LoadingShow();
            },
            success: function (res) {
                // LoadingHide();
                $('#' + tabName).html(res);
            },
            error: function (er) {
                alert(er.error);
            }
            }).fail(function (error) {
            Swal.fire({
                icon: 'error',
                title: error.status,
                html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>getListDetailPartByTab<br><br>',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false,
            });
        });

    }
    $('a[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
        var targetId = $(e.target).attr('href'); // e.g., "#tabDescription"
        if (targetId) {
            var removeFirstCharacter = targetId.substring(1);
            getListDetailPartByStkcode(removeFirstCharacter);
        }
        console.log("targetId = " + targetId);
        $('.nav-tabs li').removeClass('active');
        $(e.target).parent('li').addClass('active');
    });

