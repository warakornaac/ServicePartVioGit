                        <label for="form-text" class="form-label fs-14 text-dark"> Title : </label>
                        <input type="text" class="form-control" id="txtTitle" placeholder="Title" autocomplete="off">
                    </div>
                    <div class="col-md-12 pt-1">
                        <label for="form-text" class="form-label fs-14 text-dark"> Description : </label>
                        <textarea class="form-control" id="txtDescription" placeholder="Description" rows="2"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-dismiss="modal"> <i class="fa fa-times"></i> ปิด </button>
                <button type="button" class="btn btn-success" onclick="savePartDescription('Description');"> <i class="fa fa-save"></i> บันทึก </button>
