@{
    ViewBag.Title = "Competitor Upload";

}
<!-- PAGE-HEADER -->
<div class="page-header">
    <h1 class="page-title my-auto">Competitor Upload File Excel</h1>
    <div>
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a href="javascript:void(0)">Competitor Upload File Excel</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Competitor Upload</li>
        </ol>
    </div>
</div>
<!-- Start:: row-2 -->
<div class="col-xl-12">
    <div class="card custom-card">
        <div class="card-body">
            <div class="row justify-content-between">
                <label for="formFile" class="col-md-2 form-label mt-1" style="font-size:16px;">Import file Excel :</label>
                <div class="col-md-8 ">
                    <input class="form-control" style="padding:0.5rem 0.5rem 0.5rem 0.5rem;" type="file" id="fileInput">
                </div>
                <div class="col-md-2 text-end">
                    <button class="btn btn-primary" onclick="importFileCompititor();">Upload</button>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="col-xl-12">
    <div class="row " style="margin-left:2px;">
        <div class="col-md-6 card border border-primary">
            <div class="card-body" style=" padding: 0px;">
                <div class="table-responsive">
                    <table class="table text-nowrap">
                        <thead>
                            <tr style="text-align:center;">
                                <th colspan="3" scope="col"> ตัวอย่างไฟล์ Excel Competitor Upload</th>
                            </tr>
                            <tr>
                                <th scope="col">Stkcode</th>
                                <th scope="col">CompetitorPartNo</th>
                                <th scope="col">CompetitorBrand</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">JAR1013</th>
                                <td>Jar00001</td>
                                <td>BOSCH</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered text-start bg-white">
                        <tbody>
                            <tr>
                                <td style="text-align: -webkit-center;vertical-align: middle;"><strong>Total No. of Records: <span class="text-primary" id="spanTotal">@ViewBag.countRowImport</span></strong> </td>
                            </tr>
                            <tr>

                                <td><strong>Success: <span class="text-success" id="spanSuccess">@ViewBag.countStatusSuccess</span></strong></td>
                            </tr>
                            <tr>
                                <td><strong>Failure: <span class="text-danger" id="spanFail">@ViewBag.countStatusFail</span></strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End:: row-2 -->
<div id="ListImportExcel">
    @if (ViewBag.countRowImport > 0)
    {
        @Html.Partial("_listCompetitor")
    }
</div>

<script>
     function importFileCompititor() {
     var formData = new FormData();
     var fileInput = $("#fileInput").prop('files')[0];
     var Stkcode = '@Session["Stkcode"]';
     var InsertBy = '@Session["UserID"]';
     console.log("fileInput = " + fileInput);
     console.log("Stkcode = " + Stkcode);
     console.log("InsertBy = " + InsertBy);
     if (fileInput === undefined) {
         Swal.fire({
             icon: 'warning',
             title: 'กรุณาระบุไฟล์ที่ต้องการนำเข้า',
             confirmButtonColor: '#d33',
             confirmButtonText: 'ปิด',
             allowOutsideClick: false,
             focusConfirm: false,
         });
         return false;
     } else {
         Swal.fire({
             title: 'ยืนยันการนำเข้าข้อมูล',
             html: '',
             icon: 'warning',
             confirmButtonColor: '#3085d6',
             confirmButtonText: 'ยืนยัน',
             showCancelButton: true,
             cancelButtonColor: '#d33',
             cancelButtonText: 'ยกเลิก',
             allowOutsideClick: false,
             focusConfirm: false,
         }).then(async (result) => {
             if (result.value) {
                 formData.append('fileInput', fileInput);
                 formData.append('Stkcode', Stkcode)
                 $.ajax({
                     url: '@Url.Action("UploadCompetitor", "UploadFileExcel")',
                     type: 'post',
                     data: formData,
                     dataType: 'html',
                     cache: 'no-cache',
                     contentType: false,
                     processData: false,
                     beforeSend: function () {
                         $('#ListImportExcel').empty();
                         $('#ListImportExcel').html('<div style="padding: 30px; font-size: 18px;"> <i class="fa fa-spinner fa-spin fa-2x" aria-hidden="true"></i> กำลังโหลดข้อมูล... </div>')
                         LoadingShow();
                     },
                     success: function (data) {
                         LoadingHide();
                         $('#ListImportExcel').html(data);

                         // อัปเดต Summary จาก hidden values ที่ Partial ส่งมา
                         $('#spanTotal').text($('#hdnTotal').val());
                         $('#spanSuccess').text($('#hdnSuccess').val());
                         $('#spanFail').text($('#hdnFail').val());

                         // Init DataTable
                         if (!$.fn.DataTable.isDataTable('#tableListProduct')) {
                             $('#tableListProduct').DataTable({
                                 pageLength: 100,
                                 language: {
                                     search: "ค้นหา:",
                                     lengthMenu: "แสดง _MENU_ รายการ",
                                     info: "แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ รายการ",
                                     infoEmpty: "ไม่มีข้อมูล",
                                     zeroRecords: "ไม่พบข้อมูล",
                                     emptyTable: "ไม่มีข้อมูลในตาราง",
                                     paginate: {
                                         first: "หน้าแรก",
                                         previous: "ก่อนหน้า",
                                         next: "ถัดไป",
                                         last: "หน้าสุดท้าย"
                                     }
                                 }
                             });
                         }
                     },
                     complete: function () {
                         LoadingHide();
                     },
                 }).fail(function (error) {
                     Swal.fire({
                         icon: 'error',
                         title: 'ระบบทำงานผิดพลาด()',
                         html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>CompetitorUpload<br><br>',
                         confirmButtonColor: '#d33',
                         confirmButtonText: 'ปิด',
                         allowOutsideClick: false,
                         focusConfirm: false,
                     });
                 });
             }
         });
     }
 }
</script>
