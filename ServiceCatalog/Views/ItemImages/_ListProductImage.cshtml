@{
    ViewBag.Title = "_ListProductImage";
    var listView = ViewBag.ListProductImage;
}
<style>
    th.text-center {
        text-align: center !important;
    }
</style>
<div class="row">
    <div class="col-xl-12">
        <div class="card custom-card">
            <div class="card-header" style="padding: 10px 20px;">
                <div class="d-flex align-items-center w-100">
                    <i class="fe fe-list"></i>
                    <div class="p-1">
                        <p class="mb-0 fw-semibold fs-14 text-info"> @*@ViewBag.listSearchItemProduct.Count*@ Item </p>
                    </div>
                    <div class="dropdown ms-auto">
                        <button type="button" class="btn btn-warning btn-sm" onclick="exportItemProduct();" style="height: 35px;"><i class="bi bi-download"></i> Export Excel </button>
                    </div>
                </div>
            </div>
            <div class="card-body pt-0 p-2">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered" id="tableListProduct">
                        <thead>
                            <tr>
                                <th class="text-center">#</th>
                                <th class="text-center">Stkcode</th>
                                <th class="text-center">Stkdesc</th>
                                <th class="text-center">SeqImage</th>
                                <th class="text-center">Filename</th>
                                <th class="text-center">Url</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (listView != null)
                            {
                                var rowItem = 0;
                                foreach (var item in listView)
                                {
                                    rowItem++;
                                    <tr>
                                        <td class="text-center"><span>@rowItem</span></td>
                                        <td><span>@item.Stkcode</span></td>
                                        <td><span>@item.Stkdesc</span></td>
                                        <td class="text-center"><span>@item.SeqImage</span></td>
                                        <td><span>@item.Filename</span></td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.Url))
                                            {
                                                <a href="@item.Url" target="_blank">@item.Url</a>
                                            }
                                        </td>
                                        @*<td class="text-center">
                                <a href="@Url.Action("DownloadImage", "ItemImages", new { url = item.Url, filename = item.Filename })"
                                   class="btn btn-sm btn-primary">
                                    <i class="bi bi-download"></i> Download
                                </a>
                            </td>*@
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(item.Url))
                                            {
                                                <button class="btn btn-sm btn-primary"
                                                        onclick="previewImage('@item.Url', '@item.Filename', '@item.Stkcode')">
                                                    <i class="bi bi-image"></i> Preview
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    
                    <div class="modal fade" id="modalPreviewImage" tabindex="-1">
                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="modalImageTitle"></h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body text-center">
                                    <img id="modalImageSrc" src="" class="img-fluid" />
                                </div>
                                <div class="modal-footer">
                                    <a id="modalImageLink" href="" target="_blank"
                                       class="btn btn-success">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                        Open Full Size (คลิกขวา Save)
                                    </a>
                                    <button type="button" class="btn btn-secondary"
                                            data-bs-dismiss="modal">
                                        Close
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    //export excel
    function exportItemProduct() {
        Swal.fire({
            title: 'Do you confirm export',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#00a65a',
            cancelButtonColor: '#d33',
            confirmButtonText: '<i class="fa fa-check"></i> Yes',
            cancelButtonText: '<i class="fa fa-times"></i> No',
            allowOutsideClick: false,
            focusConfirm: false,
        }).then((result) => {
            if (result.value) {
                LoadingShow();
                LoadingHide();
                var txtProductCode = $('#txtProductCode option:selected').val();
                var txtSec = $('#txtSec option:selected').val();
                var txtStockGroup = $('#txtStockGroup option:selected').val();
                var txtCompany = $('#txtCompany option:selected').val();
                var txtStockCode = $("#stockCodeSearch").val();
                var txtStatusId = $("#txtStatusId option:selected").val();
                var txtCalldate = $("#txtCalldate").val();

                // query string
                var query =
                    '?stkcode=' + encodeURIComponent(txtStockCode) +
                    '&status=' + encodeURIComponent(txtStatusId) +
                    '&dateCall=' + encodeURIComponent(txtCalldate) +
                    '&company=' + encodeURIComponent(txtCompany) +
                    '&prodCode=' + encodeURIComponent(txtProductCode) +
                    '&sec=' + encodeURIComponent(txtSec) +
                    '&stockGroup=' + encodeURIComponent(txtStockGroup);

                window.location.href = 'ItemProduct/ExportProductItem' + query;
            }
        });
    }

    $(document).ready(function () {
        $('#tableListProduct').dataTable({
            paging: true,
            pageLength: 20,
            lengthChange: false,
            searching: false,
            ordering: false,
            //scrollY: 500,
            language: {
                info: "แสดง _START_ ถึง _END_ จากทั้งหมด _TOTAL_ ",
                infoEmpty: "ไม่มีข้อมูลให้แสดง"
            }
        });
    });

    function previewImage(url, filename, stkcode) {
        $('#modalImageTitle').text(stkcode + ' - ' + filename);
        $('#modalImageSrc').attr('src', url);
        $('#modalImageLink').attr('href', url);
        $('#modalPreviewImage').modal('show');
    }
</script>
