@using ServiceCatalog.Models;

<div class="page-header">
    <h1 class="page-title my-auto">
        Prepare Product Api
    </h1>
    <div>
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "Home")">Home</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Prepare Product Api</li>
        </ol>
    </div>
</div>
<div class="col-xl-12">
    <div class="card custom-card">
        <div class="card-header" style="padding: 10px 20px;">
            <div class="d-flex align-items-center w-100">
                <i class="fe fe-list"></i>
                <div class="p-1">
                    <p class="mb-0 fw-semibold fs-14 text-info">
                        @ViewBag.countRowImport Records
                    </p>
                </div>
            </div>
        </div>
        <div class="card-body pt-0 p-2">
            <div class="table-responsive">
                <table class="table table-striped table-bordered"
                       id="tableListProduct" style="width:100%;">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Stkcode</th>
                            <th>BrandId</th>
                            <th>BrandName</th>
                            <th>ProductCompetitorCount</th>
                            <th>ProductCompetitorDate</th>
                            <th>ProductLinkageCount</th>
                            <th>ProductLinkageDate</th>
                            <th>ApiStatus</th>
                            <th>ApiStatusRemark</th>
                            <th>InsertBy</th>
                            <th>InsertDate</th>
                        </tr>
                    </thead>
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger m-2">
                            @ViewBag.ErrorMessage
                        </div>
                    }
                    <tbody>
                        @if (ViewBag.ListProduct != null)
                        {
                            int no = 1;
                            foreach (var item in (List<PrepareProductApiModel>)ViewBag.ListProduct)
                            {
                                <tr class="@(item.ApiStatus == "N" ? "table-danger" : "")">
                                    <td>@no</td>
                                    <td>@item.Stkcode</td>
                                    <td>@item.BrandId</td>
                                    <td>@item.BrandName</td>
                                    <td>@item.ProductCompetitorCount</td>
                                    <td>@(item.ProductCompetitorDate == DateTime.MinValue ? "" : item.ProductCompetitorDate.ToString("yyyy-MM-dd HH:mm:ss"))</td>
                                    <td>@item.ProductLinkageCount</td>
                                    <td>@(item.ProductLinkageDate == DateTime.MinValue ? "" : item.ProductLinkageDate.ToString("yyyy-MM-dd HH:mm:ss"))</td>
                                    <td>@item.ApiStatus</td>
                                    <td>@item.ApiStatusRemark</td>
                                    <td>@item.InsertedBy</td>
                                    <td>@(item.InsertedDate == DateTime.MinValue ? "" : item.InsertedDate.ToString("yyyy-MM-dd HH:mm:ss"))</td>
                                </tr>
                                no++;
                            }
                        }
                    </tbody>
                    <tfoot></tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('#tableListProduct').DataTable({
            pageLength: 25,
            lengthMenu: [10, 25, 50, 100],
            order: [],
            language: {
                search: "Search:",
                lengthMenu: "Show _MENU_ List",
                // info: "แสดง _START_ ถึง _END_ จาก _TOTAL_ รายการ",
                infoEmpty: "Not Found",
                // infoFiltered: "(กรองจากทั้งหมด _MAX_ รายการ)",
                zeroRecords: "Not Found",
                paginate: {
                    first: "Fist",
                    last: "Last",
                    next: "Next",
                    previous: "Before"
                }
            }
        });
    });
</script>