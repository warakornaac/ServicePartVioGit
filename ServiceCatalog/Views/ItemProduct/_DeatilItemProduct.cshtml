    @*  *@
    @*Description*@
    <div class="col-md-12">
        <div class="card custom-card bg-transparent shadow-none border rounded">
            <div class="card-header justify-content-between p-2">
                <div class="card-title">Product Description</div>
            </div>
            <div class="card-body p-2">
                @if (ViewBag.ListProductDescription.Count > 0)
                {
                    int countDes = 0;
                    foreach (var rowDes in ViewBag.ListProductDescription)
                    {
                        countDes++;
                        <ul class="ps-3 mb-0 list-unstyled">
                            <li class="text-muted mb-1">
                                @*<i class="bx bxs-circle fs-7 me-2 op-5"></i>*@
                                <b> @rowDes.Title</b> :
                                @rowDes.Description
                            </li>
                        </ul>
                    }
                }
                else
                {
                    <ul class="ps-3 mb-0 list-unstyled">
                        <li class="text-muted">
                            No data..
                        </li>
                    </ul>
                }
            </div>
        </div>
        @*Spec*@
        <div class="col-md-12">
            <div class="card custom-card bg-transparent shadow-none border rounded">
                <div class="card-header justify-content-between p-2">
                    <div class="card-title">Product Spec</div>
                </div>
                <div class="card-body p-2">
                    @if (ViewBag.ListProductSpec.Count > 0)
                    {
                        int countSpc = 0;
                        foreach (var rowSpc in ViewBag.ListProductSpec)
                        {
                            countSpc++;
                            <ul class="ps-3 mb-0 list-unstyled">
                                <li class="text-muted mb-1">
                                    @*<i class="bx bxs-circle fs-7 me-2 op-5"></i>*@
                                    <b>@rowSpc.Title</b> :
                                    @rowSpc.Description
                                </li>
                            </ul>
                        }
                    }
                    else
                    {
                        <ul class="ps-3 mb-0 list-unstyled">
                            <li class="text-muted">
                                No data..
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>

