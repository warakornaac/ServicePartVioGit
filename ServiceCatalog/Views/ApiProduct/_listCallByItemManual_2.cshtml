                                    @{
                                        var linkageDetails = ViewBag.DataLinkage as List<ServiceCatalog.Models.LinkageDetails>;
                                    }
                                    @*content K-Type*@
                                    <div class="mb-4 ">
                                        @*<p class="fs-15 fw-semibold mb-1">Description :</p>*@
                                        <div class="card custom-card bg-transparent shadow-none border rounded">
                                            <div class="card-header">
                                                <div class="card-title text-primary">List K-Type</div>
                                            </div>
                                            <div class="card-body p-2">
                                                <div class="row">
                                                    @{
                                                        var rowLinkage = 0;
                                                        if (linkageDetails == null)
                                                        {
                                                            <div class="alert alert-danger text-center mt-2" style="font-size: 16px; font-weight: bold;"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i> ไม่พบข้อมูล PartNo Specific </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="table-responsive table-scrollable">
                                                                <table class="table text-nowrap table-striped table-hover">
                                                                    <thead>
                                                                        <tr>
                                                                            <th scope="col">#</th>
                                                                            <th scope="col">KType</th>
                                                                            <th scope="col">Marker</th>
                                                                            <th scope="col">รุ่น/ปีที่ผลิต</th>
                                                                            <th scope="col">DriveType </th>
                                                                            <th scope="col">BodyStyle </th>
                                                                            <th scope="col">FuelMixtureFormationType  </th>
                                                                            <th scope="col">FuelType </th>
                                                                            <th scope="col">EngineType   </th>
                                                                            <th scope="col">Engines    </th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var rowData in linkageDetails)
                                                                        {
                                                                            ++rowLinkage;
                                                                            <tr>
                                                                                <td scope="row">@rowLinkage</td>
                                                                                <td scope="row">@rowData.LinkageTargetId</td>
                                                                                <td scope="row">@rowData.MfrName</td>
                                                                                <td>
                                                                                    <div class="d-flex align-items-center">
                                                                                        <div class="avatar me-2">
                                                                                            <img src="@rowData.ImageURL" alt="img">
                                                                                        </div>
                                                                                        <div>
                                                                                            <div class="lh-1">
                                                                                                <span>@rowData.VehicleModelSeriesName </span>
                                                                                            </div>
                                                                                            <div class="lh-1">
                                                                                                <span class="fs-11 text-muted">
                                                                                                    @(!string.IsNullOrEmpty(rowData.BeginYearMonth) ? rowData.BeginYearMonth : "-") /
                                                                                                    @(!string.IsNullOrEmpty(rowData.EndYearMonth) ? rowData.EndYearMonth : "-")
                                                                                                </span>
                                                                                            </div>
                                                                                        </div>
                                                                                    </div>
                                                                                </td>
                                                                                <td>@rowData.DriveType</td>
                                                                                <td>@rowData.BodyStyle</td>
                                                                                <td>@rowData.FuelMixtureFormationType</td>
                                                                                <td>
                                                                                    <span class="badge bg-success-transparent">
                                                                                        <i class="ri-check-fill align-middle me-1"></i>@rowData.FuelType
                                                                                    </span>
                                                                                </td>
                                                                                <td>@rowData.EngineType</td>
                                                                                <td>@rowData.Engines</td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
