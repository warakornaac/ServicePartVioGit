@using System.Linq
@using ServiceCatalog.Models;
<style>
    .table-scrollable {
        max-height: 500px; /* adjust height as needed */
        overflow-y: auto;
    }

    .table-responsive::-webkit-scrollbar {
        height: 8px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background-color: rgba(0, 0, 0, 0.2);
        border-radius: 4px;
    }
</style>
<div class="row">
    <div class="col-xl-12">
        <div class="card custom-card">
            <div class="card-body">
                <div class="row ">
                    <div class="col-xxl-4 col-xl-12">
                        <div class="row">
                            <div class="col-xxl-12 col-xl-12 col-lg-8 col-md-8 col-sm-12">
                                <div class="card custom-card bg-transparent shadow-none border rounded">
                                    <div class="card-header flex-between justify-content-between">
                                        <div class="card-title text-primary">Product Image</div>
                                    </div>
                                    <div class="card-body p-2">
                                        <div class="col-xl-12">
                                            @{
                                                if (ViewBag.dataResponse.Images != null && (ViewBag.dataResponse.Images).Count > 0)
                                                {
                                                    <div class="col-xxl-10 col-xl-12 col-lg-12 col-md-12 col-sm-12 mb-md-5 mb-12">
                                                        <div class="">
                                                            <div class="swiper swiper-preview-details bd-gray-100 product-details-page">
                                                                <div class="swiper-wrapper">
                                                                    @foreach (var rowDataImage in ViewBag.dataResponse.Images)
                                                                    {
                                                                        <div class="swiper-slide d-flex justify-content-center align-items-center">
                                                                            <img class="img-fluid" src="@rowDataImage.imageURL800" alt="@rowDataImage.fileName" style="width:300px; height:auto;">
                                                                        </div>
                                                                    }
                                                                </div>
                                                                <div class="swiper-button-next"></div>
                                                                <div class="swiper-button-prev"></div>
                                                            </div>
                                                            <div class="swiper swiper-view-details mt-2 swiper-initialized swiper-horizontal swiper-pointer-events swiper-free-mode swiper-watch-progress swiper-backface-hidden swiper-thumbs">
                                                                <div class="swiper-wrapper" id="swiper-wrapper-aa9f59d1069c0c416" aria-live="polite" style="transform: translate3d(0px, 0px, 0px); transition-duration: 0ms;">
                                                                    @foreach (var rowDataImage in ViewBag.dataResponse.Images)
                                                                    {
                                                                        <div class="swiper-slide swiper-slide-visible swiper-slide-active" role="group" aria-label="1 / 4" style="width: 82px; margin-right: 10px;">
                                                                            <img class="img-fluid" src="@rowDataImage.imageURL100" alt="img">
                                                                        </div>
                                                                    }
                                                                </div>
                                                                <span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="fs-12 text-muted" style="padding-left: 20px;">
                                                        <i class="ri-alert-line fs-3"> </i>
                                                        No product data found for item number
                                                        <b><u>@ViewBag.dataProductByMobile[0].Stkcode</u></b>
                                                        from Techdoc API.
                                                    </span>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @*K-Type*@
                    <div class="col-xxl-8 col-xl-12 ">
                        <div class="row product-scroll">
                            <div class="col-xl-12 mt-xxl-0 mt-3">
                                <div>
                                    @*<p class="fs-18 fw-semibold mb-0 text-info">
                                            <i class="ri-star-s-fill text-warning align-middle"></i>
                                            @ViewBag.mfrName[0]
                                            @if (ViewBag.dataResponse.GenericArticles != null)
                                            {
                                                foreach (var rowDataImage in ViewBag.dataResponse.GenericArticles)
                                                {
                                                    @rowDataImage.genericArticleDescription @rowDataImage.assemblyGroupName
                                                }
                                            }
                                        </p>*@

                                    @{
                                        var linkageDetails = ViewBag.DataLinkage as List<ServiceCatalog.Models.LinkageDetails>;
                                    }
                                    <div class="mb-4 ">
                                        @*content Product-detail*@
                                        <div class="card custom-card bg-transparent shadow-none border rounded">
                                            <div class="card-header flex-between justify-content-between">
                                                <div class="card-title text-info">Product Detail By AAC&TRU</div>
                                            </div>
                                            <div class="card-body p-3">
                                                <div class="col-xl-12">
                                                    @*Data By API*@
                                                    @if (!string.IsNullOrEmpty(ViewBag.dataProductByMobile[0].Stkcode))
                                                    {
                                                        var item = ViewBag.dataProductByMobile[0];
                                                        var company = item.Company;

                                                        <div class="row text-success">
                                                            <div class="col-sm-12 mb-1">
                                                                <span class="fs-14 fw-semibold"> เบอร์สินค้า : </span>
                                                                <span class="fw-semibold justify-content-between">
                                                                    @item.Stkcode

                                                                    @if (!string.IsNullOrEmpty(company))
                                                                    {
                                                                        <text>(@company)</text>
                                                                    }
                                                                </span>
                                                            </div>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(ViewBag.dataProductByMobile[0].Stkdes))
                                                    {
                                                        <div class="row text-success">
                                                            <div class="col-sm-12 mb-1">
                                                                <span class="fs-14 fw-semibold"> คำอธิบายสินค้า : </span>
                                                                @ViewBag.dataProductByMobile[0].Stkdes
                                                            </div>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(ViewBag.dataProductByMobile[0].Moq))
                                                    {
                                                        <div class="row text-success">
                                                            <div class="col-sm-12 mb-1">
                                                                <span class="fs-14 fw-semibold"> MOQ : </span>
                                                                @ViewBag.dataProductByMobile[0].Moq
                                                            </div>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(ViewBag.dataProductByMobile[0].Price))
                                                    {
                                                        <div class="row text-success">
                                                            <div class="col-sm-12 mb-1">
                                                                <span class="fs-14 fw-semibold"> Price : </span>
                                                                @*<span class="fw-semibold text-danger">
                                                                           @(
                                                                               string.IsNullOrEmpty(ViewBag.dataProductByMobile[0].Price)
                                                                               ? "0.00"
                                                                               : Convert.ToDecimal(ViewBag.dataProductByMobile[0].Price).ToString("N2") + " ฿"
                                                                           )
                                                                    </span>*@
                                                                <span class="fw-semibold text-danger">
                                                                    @(
                                                                        string.IsNullOrEmpty(ViewBag.dataProductByMobile[0].Price)
                                                                        ? "0.00"
                                                                        : Convert.ToDecimal(ViewBag.dataProductByMobile[0].Price).ToString("N2") + " ฿"
                                                                    )
                                                                    <span class="text-muted text-decoration-line-through ms-1 op-6">
                                                                        @(
                                                                        string.IsNullOrEmpty(ViewBag.dataProductByMobile[0].Price)
                                                                        ? "0.00"
                                                                        : (Convert.ToDecimal(ViewBag.dataProductByMobile[0].Price) * 1.10M).ToString("N2") + " ฿"
                                                                        )
                                                                    </span>
                                                                </span>
                                                            </div>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrEmpty(ViewBag.dataProductByMobile[0].StockReady))
                                                    {
                                                        <div class="row text-success">
                                                            <div class="col-sm-12 mb-1">
                                                                <span class="fs-14 fw-semibold"> StockReady : </span>
                                                                @ViewBag.dataProductByMobile[0].StockReady
                                                                <input type="hidden" value="@ViewBag.dataProductByMobile[0].StockReady" id="txtStockReady">
                                                            </div>
                                                        </div>
                                                    }
                                                    <div class="row text-success pt-1 pb-2">
                                                        <div class="col-md-12">
                                                            <span class="fs-14 fw-semibold me-2">Quatity :</span>
                                                            <input type="text" class="form-control w-auto" id="txtQuatity" placeholder="Input quatity" autocomplete="off" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                                                        </div>
                                                    </div>
                                                    <div class="row text-success pd-2">
                                                        <div class="col-md-12">
                                                            <span class="fs-14 fw-semibold me-2">BackOrder :</span>
                                                            <input type="text" class="form-control w-auto" id="txtBo" placeholder="Input bo" autocomplete="off" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-footer">
                                                <div class="d-flex">
                                                    <div class="ms-auto">
                                                        <button type="button" class="btn btn-success-light" id="btnAddToCart" onClick="fnAddToCart();"> <i class="ri-shopping-cart-2-line"></i> Add to cart </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card custom-card bg-transparent shadow-none border rounded">
                                        <div class="card-header flex-between justify-content-between">
                                            <div class="card-title text-primary">Product Detail By Techdoc</div>
                                        </div>
                                        <div class="card-body p-3">
                                            <div class="col-xl-12">
                                                @if (ViewBag.mfrName.Count == 0)
                                                {
                                                    <span class="fs-12 text-muted">
                                                        <i class="ri-alert-line fs-3" style="vertical-align:-5px;"></i>
                                                        No product data found for item number
                                                        <b><u>@ViewBag.dataProductByMobile[0].Stkcode</u></b>
                                                        from Techdoc API.
                                                    </span>
                                                }
                                                else
                                                {
                                                    if (ViewBag.mfrName.Count != 0)
                                                    {
                                                        <div class="row">
                                                            <div class="col-sm-12 mb-1">
                                                                <span class="fs-14 fw-semibold"> แบรนด์ : </span>
                                                                @ViewBag.mfrName[0]
                                                            </div>
                                                        </div>
                                                    }
                                                    if (ViewBag.articleNumber[0] != null)
                                                    {
                                                        <div class="row">
                                                            <div class="col-sm-12 mb-1">
                                                                <span class="fs-14 fw-semibold">หมายเลขสินค้า : </span>
                                                                @ViewBag.articleNumber[0]
                                                            </div>
                                                        </div>
                                                    }
                                                    if (ViewBag.dataResponse.GenericArticles != null)
                                                    {
                                                        <div class="row">
                                                            <div class="col-sm-12 mb-1">
                                                                <span class="fs-14 fw-semibold">กลุ่มผลิตภัณฑ์ : </span>
                                                                @foreach (var rowDataGene in ViewBag.dataResponse.GenericArticles)
                                                                {
                                                                    @rowDataGene.genericArticleDescription
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                    if (ViewBag.quantityPerPackage[0] != null)
                                                    {
                                                        <div class="row">
                                                            <div class="col-sm-12 mb-1">
                                                                <span class="fs-14 fw-semibold">หน่วยบรรจุภัณฑ์ : </span>
                                                                @if (ViewBag.quantityPerPackage[0] != null)
                                                                {
                                                                    @ViewBag.quantityPerPackage[0]
                                                                }
                                                                else
                                                                {
                                                                    @: -
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                    if (ViewBag.additionalDescriptions[0] != null)
                                                    {
                                                        <div class="row">
                                                            <div class="col-sm-12 mb-1">
                                                                <span class="fs-14 fw-semibold">คำอธิบายเพิ่มเติม : </span>
                                                                @if (ViewBag.additionalDescriptions[0] != null)
                                                                {
                                                                    @ViewBag.additionalDescriptions[0]
                                                                }
                                                                else
                                                                {
                                                                    @: -
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                    if (ViewBag.dataResponse.TradeNumberDetail.Count > 0)
                                                    {
                                                        <div class="row">
                                                            <div class="col-sm-12 mb-1">
                                                                <span class="fs-14 fw-semibold">หมายเลขการใช้งาน : </span>
                                                                @if (ViewBag.dataResponse.TradeNumberDetail != null && (ViewBag.dataResponse.TradeNumberDetail).Count > 0)
                                                                {
                                                                    var tradeNumbers = ViewBag.dataResponse.TradeNumberDetail;
                                                                    for (int i = 0; i < tradeNumbers.Count; i++)
                                                                    {
                                                                        @tradeNumbers[i].tradeNumber
                                                                        if (i < tradeNumbers.Count - 1)
                                                                        {
                                                                            @:|
                                                                        }
                                                                    }
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-12 mt-xxl-0">
                                <div class="border p-3 rounded-3 mb-3">
                                    <p class="fs-15 fw-semibold mb-2 text-primary">Product Specifications :</p>
                                    <div class="row">
                                        <div class="col-xl-12">
                                            <ul class="ps-3 mb-0 list-unstyled">
                                                @{
                                                    var criteriaList = ViewBag.dataResponse?.ArticleCriteria as List<ArticleCriteria>;
                                                    if (criteriaList != null && criteriaList.Any())
                                                    {
                                                        var grouped = criteriaList
                                                            .GroupBy(c => new
                                                            {
                                                                c.criteriaId,
                                                                c.criteriaDescription,
                                                                c.criteriaUnitDescription
                                                            });
                                                        foreach (var group in grouped)
                                                        {
                                                            var formattedValues = string.Join(" | ", group.Select(g => g.formattedValue));
                                                            <li class="text-muted mb-2">
                                                                <i class="bx bxs-circle fs-7 me-2 op-5"></i>
                                                                <b>@group.Key.criteriaDescription</b> : @formattedValues
                                                                @if (!string.IsNullOrWhiteSpace(group.Key.criteriaUnitDescription))
                                                                {
                                                                    @($" {group.Key.criteriaUnitDescription}")
                                                                }
                                                            </li>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="fs-12 text-muted">
                                                            <i class="ri-alert-line fs-3" style="vertical-align:-5px;"></i>
                                                            No product data found for item number
                                                            <b><u>@ViewBag.dataProductByMobile[0].Stkcode</u></b>
                                                            from Techdoc API.
                                                        </span>
                                                    }
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div class="border p-3 rounded-3 mb-3 mt-3">
                                    <p class="fs-15 fw-semibold mb-2 text-primary">OEM Number :</p>
                                    <div class="row">
                                        <div class="col-xl-12">
                                            <ul class="ps-3 mb-0 list-unstyled">
                                                @{
                                                    if (ViewBag.dataResponse.OemNumbers != null && (ViewBag.dataResponse.OemNumbers).Count > 0)
                                                    {
                                                        foreach (var rowDataOem in ViewBag.dataResponse.OemNumbers)
                                                        {
                                                            <li class="text-muted mb-2">
                                                                <i class="bx bxs-circle fs-7 me-2 op-5"></i>
                                                                <b>@rowDataOem.articleNumber</b> :  @rowDataOem.mfrName
                                                            </li>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="fs-12 text-muted">
                                                            <i class="ri-alert-line fs-3" style="vertical-align:-5px;"></i>
                                                            No product data found for item number
                                                            <b><u>@ViewBag.dataProductByMobile[0].Stkcode</u></b>
                                                            from Techdoc API.
                                                        </span>
                                                    }
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                @{ var partNumberNearbyDetails = ViewBag.dataCompetitor as List<ServiceCatalog.Models.PartNumberNearby>; }
                                <div class="border p-3 rounded-3 mb-0">
                                    <p class="fs-15 fw-semibold mb-3 text-primary">Competitor number :</p>
                                    <div class="row">
                                        <div class="col-xl-12">
                                            <ul class="ps-3 mb-0 list-unstyled">
                                                @{
                                                    if (partNumberNearbyDetails != null)
                                                    {
                                                        foreach (var rowDataCompe in partNumberNearbyDetails)
                                                        {
                                                            <li class="text-muted mb-2">
                                                                <i class="bx bxs-circle fs-7 me-2 op-5"></i>
                                                                <b>@rowDataCompe.articleNo </b> &nbsp; : &nbsp; @rowDataCompe.brandName
                                                            </li>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="fs-12 text-muted">
                                                            <i class="ri-alert-line fs-3" style="vertical-align:-5px;"></i>
                                                            No product data found for item number
                                                            <b><u>@ViewBag.dataProductByMobile[0].Stkcode</u></b>
                                                            from Techdoc API.
                                                        </span>
                                                    }
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                @*content K-Type*@
                                <div class="mt-3">
                                    <div class="card custom-card bg-transparent shadow-none border rounded">
                                        <div class="card-header">
                                            <div class="card-title text-primary">List K-Type</div>
                                        </div>
                                        <div class="card-body p-2">
                                            <div class="row">
                                                @{
                                                    var rowLinkage = 0;
                                                    if (linkageDetails == null)
                                                    {
                                                        @*<div class="alert alert-danger text-center " style="font-size: 16px; font-weight: bold;"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i> ไม่พบข้อมูล </div>*@
                                                        <span class="fs-12 text-muted" style="padding-left: 20px;">
                                                            <i class="ri-alert-line fs-3" style="vertical-align:-5px;"> </i>
                                                            No product data found for item number
                                                            <b><u>@ViewBag.dataProductByMobile[0].Stkcode</u></b>
                                                            from Techdoc API.
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <div class="table-responsive table-scrollable">
                                                            <table class="table text-nowrap table-striped table-hover">
                                                                <thead>
                                                                    <tr>
                                                                        <th scope="col">#</th>
                                                                        <th scope="col">KType</th>
                                                                        <th scope="col">Marker</th>
                                                                        <th scope="col">รุ่น/ปีที่ผลิต</th>
                                                                        <th scope="col">DriveType </th>
                                                                        <th scope="col">BodyStyle </th>
                                                                        <th scope="col">FuelMixtureFormationType  </th>
                                                                        <th scope="col">FuelType </th>
                                                                        <th scope="col">EngineType   </th>
                                                                        <th scope="col">Engines    </th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var rowData in linkageDetails)
                                                                    {
                                                                        ++rowLinkage;
                                                                        <tr>
                                                                            <td scope="row">@rowLinkage</td>
                                                                            <td scope="row">@rowData.LinkageTargetId</td>
                                                                            <td scope="row">@rowData.MfrName</td>
                                                                            <td>
                                                                                <div class="d-flex align-items-center">
                                                                                    <div class="avatar me-2">
                                                                                        <img src="@rowData.ImageURL" alt="img">
                                                                                    </div>
                                                                                    <div>
                                                                                        <div class="lh-1">
                                                                                            <span>@rowData.VehicleModelSeriesName </span>
                                                                                        </div>
                                                                                        <div class="lh-1">
                                                                                            <span class="fs-11 text-muted">
                                                                                                @(!string.IsNullOrEmpty(rowData.BeginYearMonth) ? rowData.BeginYearMonth : "-") /
                                                                                                @(!string.IsNullOrEmpty(rowData.EndYearMonth) ? rowData.EndYearMonth : "-")
                                                                                            </span>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </td>
                                                                            <td>@rowData.DriveType</td>
                                                                            <td>@rowData.BodyStyle</td>
                                                                            <td>@rowData.FuelMixtureFormationType</td>
                                                                            <td>
                                                                                <span class="badge bg-success-transparent">
                                                                                    <i class="ri-check-fill align-middle me-1"></i>@rowData.FuelType
                                                                                </span>
                                                                            </td>
                                                                            <td>@rowData.EngineType</td>
                                                                            <td>@rowData.Engines</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" src="~/Scripts/product-details.js"></script>
@*@Scripts.Render("~/Scripts/scriptApiProduct.js")*@

<script defer>
    var txtPartNo = $("#txtPartNo").val();
    console.log(document.readyState);
    if (document.readyState == "complete") {
        setTimeout(function () {
            GetProductApiCount(txtPartNo.trim());
        }, 1000);
    }
    //btn delete
    function fnAddToCart() {
        var msg = '';
        var error = 0;

        var txtQuatity = parseInt($("#txtQuatity").val()) || 0;
        var txtBo = $("#txtBo").val() || 0;
        var txtStockReady = parseInt($("#txtStockReady").val()) || 0;

        if (Number(txtQuatity) > Number(txtStockReady)) {
            ++error;
            msg += '<br>' + error + '. จำนวนสินค้า Quatity(' + txtQuatity +') ห้ามเกินจำนวน txtStockReady('+txtStockReady+') ';
        }

        if ((txtQuatity == "" && txtBo == "") || (txtQuatity == 0 && txtBo == 0)) {
            ++error;
            msg += '<br>' + error + '. กรุณากรอกจำนวนที่ช่อง Quatity, BackOrder';
        }
        //console.log("txtPartNo = " + txtPartNo);
        //console.log("txtBrandId = " + txtBrandId);
        //return false;
        if (error) {
            Swal.fire({
                icon: 'warning',
                title: 'กรุณาตรวจสอบข้อมูลต่อไปนี้',
                html: msg,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Close',
                allowOutsideClick: false,
                focusConfirm: false,
            });
            return false;
        } else {
            Swal.fire({
                icon: 'info',
                //title: 'อยู่ในช่วงพัฒนา ยังไม่สามารถเพิ่มสินค้าไปยังตะกร้าได้',
                html: "ฟังก์ชันนี้อยู่ระหว่างการพัฒนา ขณะนี้ยังไม่สามารถเพิ่มสินค้าเข้าตะกร้าได้",
                confirmButtonColor: '#d33',
                confirmButtonText: 'Close',
                allowOutsideClick: false,
                focusConfirm: false,
            });
        }
    }
</script>
