@using ServiceCatalog.Models;
@{
    List<SelectListItem> getListBrand = ViewBag.listBrand;
}

<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>

<div class="page-header">
    <h1 class="page-title my-auto">Product & Brand Search</h1>
    <div>
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index","Home")">Home</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page"> Product Search </li>
        </ol>
    </div>
</div>
@*form search*@
<div class="row">
    <div class="col-xl-12">
        <div class="card custom-card">
            <div class="card-header justify-content-between"> <div class="card-title"> Search Product (JAR188, LBB127) </div> <div class="prism-toggle"> </div> </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <label for="form-text" class="form-label fs-14 text-dark">PartNumber :</label>
                        <div class="input-group">
                            <div class="input-group-text">
                                <i class="ri-settings-5-fill"></i>
                            </div>
                            <input type="text" class="form-control" id="txtPartNo" value="" placeholder="INPUT PART NUMBER">
                            <input type="hidden" class="form-control" id="stockCodeSearch">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label for="form-text" class="form-label fs-14 text-dark">Brand :</label>
                        <div class="input-group">
                            <div class="input-group-text">
                                <i class="ri-roadster-fill"></i>
                            </div>
                            <select class="form-control selectpicker" id="txtBrandId" name="txtBrandId" style="width: 100%;" data-live-search="true" title="SELECT BRAND">
                                <option value="ALL">SELECT BRAND</option>
                                @for (var i = 0; i < getListBrand.Count; i++)
                                {
                                    @*<option value="@getListBrand[i].Value">@getListBrand[i].Text</option>*@
                                    <option value="@getListBrand[i].Value"> @getListBrand[i].Text </option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="row text-right">
                    <div class="col-xs-12 col-md-12 text-end">
                        <button class="btn btn-primary" onclick="getArticlesByPartno();"><i class="ri-search-line"></i> Search</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@*content responsd api*@
<div id="showResultArticlesByPartno" class="pt-1 pb-1"></div>

@*@Scripts.Render("~/Scripts/scriptApiProduct.js")*@

<script defer>
    $("#txtPartNo").on("focus", function () {
        $(this).select();
    });
    //get stkcode
    $("#txtPartNo").autocomplete({
        minLength: 4,
        selectFirst: true,
        autoFocus: true,
        source: function (request, response) {
            var param = {
                txtSearch: $("#txtPartNo").val(),
                company: $('#txtCompany option:selected').val(),
                secCode: $('#txtSec option:selected').val(),
                stockGroup: $('#txtStockGroup option:selected').val(),
                prodCode: $('#txtProductCode option:selected').val(),
            };
            $.ajax({
                url: '@Url.Action("getStockCode", "PartSpecification")',
                data: JSON.stringify(param),
                dataType: "json",
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataFilter: function (data) { return data; },
                success: function (data) {
                    response($.map(data.slice(0, 50), function (item) {
                        var text = item;
                        var hiddenValue = '';
                        if (item && item.lastIndexOf('|') > -1) {
                            text = item.substring(0, item.lastIndexOf('|')).trim();
                            hiddenValue = item.substring(item.lastIndexOf('|') + 1).trim();
                        }
                        return {
                            label: text,        // แสดง
                            value: text,        // ใส่ใน textbox
                            brandId: hiddenValue // ซ่อน ใช้งานต่อ
                        };
                    }))
                },
                error: function (XMLhttpsRequest, textStatus, errorThrown) {
                    alert(textStatus);
                }
            });
        },
        select: function (event, ui) {
            var _val = ui.item.value;
            var _splito = "";
            _splito = _val.split('|');
            var splitval = _splito;
            _scus = _splito[0].trim();
            console.log("sub(0) = " + _splito[0].trim() + " sub(1) = " + _splito[1].trim() + " sub(2) = " + ui.item.brandId)
            //searchPartByStkcode(_splito[0].trim());
            if (_splito[0] != null) {
                $("#stockCodeSearch").val(_splito[0].trim());
            }
            if (ui.item.brandId != null) {
                setDefaultBrandId(ui.item.brandId);
            }
            if (_splito[0] != null && ui.item.brandId != undefined) {
                getArticlesByPartno(_splito[0].trim(), ui.item.brandI);
            }

        },
    });
    function setDefaultBrandId(brandId) {
        if (brandId != null) {
            //alert(brandId);
            brandId = parseInt(brandId, 10);
            $("#txtBrandId").val(brandId);
            $("#txtBrandId").selectpicker('refresh');
        }
    }
    //call api
    function getArticlesByPartno(txtPartNoAuto, txtBrandIdAuto) {
        var txtPartNo = $("#stockCodeSearch").val() || "";
        var txtBrandId = $("#txtBrandId option:selected").val() || "";
        //if (txtPartNoAuto != "" && txtBrandIdAuto != 0) {
        //    txtPartNo = txtPartNoAuto;
        //    txtBrandId = txtBrandIdAuto;
        //}
        var msg = '';
        var error = 0;
        if ((!txtPartNo || txtPartNo.trim() === "") || (!txtBrandId || txtBrandId.trim() === "")) {
            ++error;
            msg += '<br>' + error + '. กรุณากรอก Partno, Brand ';
        }
        if (error) {
            Swal.fire({
                icon: 'warning',
                title: 'กรุณาตรวจสอบข้อมูลต่อไปนี้',
                html: msg,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Close',
                allowOutsideClick: false,
                focusConfirm: false,
            });
            return false;
        } else {
            //check call api
            $.ajax({
                url: '@Url.Action("checkApiDataByPartno", "ApiProduct")',
                data: {
                    PartNo: txtPartNo.trim(),
                    BrandId: txtBrandId
                },
                type: "POST",
                dataType: "JSON",
                beforeSend: function () {
                    $('#showResultArticlesByPartno').empty();
                    Swal.fire({
                        title: 'Searching...',
                        text: 'Please wait while we search for the product.',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });
                },
                success: function (data) {
                    //console.log(data);
                    //return false;
                    if (data.statusCallApi) { //call success
                        //if (data.MfrNames[0] != null) { //call find data
                            $.ajax({
                                url: '@Url.Action("getArticlesByPartnoByTechdoc", "ApiProduct")',
                                type: 'POST',
                                data: {
                                    PartNo: txtPartNo.trim(),
                                    BrandId: txtBrandId
                                },
                                dataType: 'html',
                                cache: false,
                                Async: true,
                                beforeSend: function () {
                                    $('#showResultArticlesByPartno').empty();
                                    //$('#showResultArticlesByPartno').html('<div style="padding: 30px; font-size: 14px;"> <i class="fa fa-spinner fa-spin" style="font-size: 24px;" aria-hidden="true"></i> กำลังโหลดข้อมูล Api Product ... </div>');
                                    //LoadingShow();
                                    Swal.fire({
                                        title: 'Searching...',
                                        text: 'Please wait while we search for the product.',
                                        allowOutsideClick: false,
                                        didOpen: () => {
                                            Swal.showLoading();
                                        }
                                    });
                                },
                                success: function (res) {
                                    Swal.close();
                                    $('#showResultArticlesByPartno').html(res);

                                    //LoadingHide();
                                }
                            });
                        //} else {    ////call not find data
                        //    Swal.fire({
                        //        icon: 'warning',
                        //        //title: res.msg,
                        //        html: 'Product information not found',
                        //        confirmButtonColor: '#d33',
                        //        confirmButtonText: 'Close',
                        //        allowOutsideClick: false,
                        //        focusConfirm: false,
                        //    });
                        //}
                    } else { //call fail api | not run
                        Swal.fire({
                            icon: 'error',
                            title: 'API service not run',
                            html: data.statusCode,
                            confirmButtonColor: '#d33',
                            confirmButtonText: 'Close',
                            allowOutsideClick: false,
                            focusConfirm: false,
                        });
                    }
                }
            });
        }
    }
</script>
