                //        console.error("ไม่พบชีทชื่อ 'K-Type Data'");
                //        return;
                //    }

                //    var worksheet = workbook.Sheets[sheetName];
                //    var json = XLSX.utils.sheet_to_json(worksheet, { header: 1 });

                //    if (json.length > 0) {
                //        var headers = json[0];

                //        var rows = json.slice(1).map(row => {
                //            //row ให้เท่ากับ headers
                //            if (row.length < headers.length) {
                //                while (row.length < headers.length) row.push("");
                //            } else if (row.length > headers.length) {
                //                row = row.slice(0, headers.length);
                //            }
                //            return row;
                //        });

                //        //ถ้ามี DataTable ล้างก่อน
                //        if ($.fn.DataTable.isDataTable("#excelTable")) {
                //            $("#excelTable").DataTable().clear().destroy();
                //            $("#excelTable thead").empty();
                //        }

                //        //สร้าง DataTable ใหม่
                //        $("#excelTable").DataTable({
                //            data: rows,
                //            columns: headers.map(h => ({ title: h })),
                //            destroy: true,
                //            searching: false
                //        });
                //    }
                //};



                //reader.readAsArrayBuffer(file);
            });

            dz.on("success", function () {
                alert("Upload Success!");
                dz.removeAllFiles(true);
                $("#name-upload").addClass('d-none');
                $("#fileName").html("");

                if ($.fn.DataTable.isDataTable("#excelTable")) {
                    $("#excelTable").DataTable().clear().draw();
                }
            });

            dz.on("removedfile", function () {
                $("#name-upload").addClass('d-none');
                $("#fileName").html("");
            });

            //$("#uploadBtn").on("click", function () {
            //    if (dz.getQueuedFiles().length > 0) {
            //        dz.processQueue();
            //    } else {
