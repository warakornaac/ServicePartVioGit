        Drag and Drop your Excel file here!
    `,
        init: function () {
            var dz = this;

            dz.on("addedfile", function (file) {
                if (dz.files.length > 1) {
                    dz.removeFile(dz.files[0]);
                }

                $("#name-upload").removeClass('d-none');
                var imgHtml = `
                <img src="/Image/Microsoft_Office_Excel_(2019–present).svg.png"
                    style="width:32px; height:32px; object-fit:contain; margin-right:8px;" />
                <span>${file.name}</span>
            `;
                $("#fileName").html(imgHtml);

                //// อ่านไฟล์ด้วย SheetJS
