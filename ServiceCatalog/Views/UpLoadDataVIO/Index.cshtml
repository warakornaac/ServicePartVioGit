    });

    function clickUpload() {
        console.log("ไฟล์ทั้งหมดใน Dropzone:", myDropzone.files);

        if (myDropzone.files.length > 0) {
            var file = myDropzone.files[0];
            swal.fire({
                title: 'ยืนยันการนำเข้าข้อมูล',
                html: '',
                icon: 'question',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'ยืนยัน',
                showCancelButton: true,
                cancelButtonColor: '#d33',
                cancelButtonText: 'ยกเลิก',
                allowOutsideClick: false,
                focusConfirm: false,
            }).then(async (result) => {
                if (result.value) {
                    importExcelVIO();
                }
                else {
                    Swal.fire({
                        icon: 'warning',
                        title: 'NO',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                }
            });
        } else {
            Swal.fire({
                icon: 'warning',
                title: 'กรุณาระบุไฟล์ที่ต้องการนำเข้า',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false,
            });
        }
    }


    function importExcelVIO() {
        if (myDropzone.files.length > 0) {
            var file = myDropzone.files[0];
            var formData = new FormData();
            formData.append("file", file);

            $.ajax({
                url: "@Url.Action("ExcelFile", "UpLoadDataVIO")",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                beforeSend: function () {
                    Swal.fire({
                        title: 'Searching...',
                        text: 'Please wait while we processing on the product.',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });
                },
                success: function (res) {
                    Swal.close();
                    //console.log("อัพโหลดสำเร็จ:", res);
                    var pageHtml = '';
                    var i = 0;
                    var outUpload = '';
                    if (res.success) {
                        outUpload = res.outResult;
                        if (res.data.length > 0) {
                            let tableHtml = `
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>KType</th>
                                            <th>Maker</th>
                                            <th>Model</th>
                                            <th>Body</th>
                                            <th>EngineType</th>
                                            <th>YearFrom</th>
                                            <th>YearTo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                            `;
                            res.data.forEach(item => {
                                //if (item.KType !== '') {
                                //    i++;
                                //    tableHtml += `
                                //    <tr>
                                //        <td>${item.KType || ''}</td>
                                //        <td>${item.Maker || ''}</td>
                                //        <td>${item.Model || ''}</td>
                                //        <td>${item.Body || ''}</td>
                                //        <td>${item.EngineType || ''}</td>
                                //        <td>${item.YearFrom || ''}</td>
                                //        <td>${item.YearTo || ''}</td>

                                //    </tr>
                                //`;
                                //}
                                i++;
                                tableHtml += `
                                    <tr>
                                        <td>${item.KType || ''}</td>
                                        <td>${item.Maker || ''}</td>
                                        <td>${item.Model || ''}</td>
                                        <td>${item.Body || ''}</td>
                                        <td>${item.EngineType || ''}</td>
                                        <td>${item.YearFrom || ''}</td>
                                        <td>${item.YearTo || ''}</td>

                                    </tr>
                                `;

                            });//end Loop
                            tableHtml += `
                                    </tbody>
                                </table>
                            `;
                            if (i > 0) {
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'พบเจอข้อมูลอัพโหลดไม่สำเร็จ',
                                    html: 'อัพโหลดสำเร็จ : ' + outUpload + ' รายการ' + '<br>' +`<div class="table-responsive" style="text-align:left; max-height:300px; overflow-y:auto;">${tableHtml}</div> `,
                                    width: '80%',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'ปิด',
                                    allowOutsideClick: false,
                                    focusConfirm: false,
                                });
                            } else {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'อัพโหลดสำเร็จ',
                                    html: res.message + '<br>' + 'อัพโหลดสำเร็จ : ' + outUpload+ ' รายการ',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'ปิด',
                                    allowOutsideClick: false,
                                    focusConfirm: false,
                                });
                            }
                        }
                        else {
                            Swal.fire({
                                icon: 'success',
                                title: 'อัพโหลดสำเร็จ',
                                html: res.message + '<br>' + 'อัพโหลดสำเร็จ : ' + outUpload + ' รายการ',
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'ปิด',
                                allowOutsideClick: false,
                                focusConfirm: false,
                            });
                        }
                    }
                    else {
                        Swal.fire({
                            icon: 'error',
                            title: 'อัพโหลดล้มเหลว',
                            html: res.message,
                            confirmButtonColor: '#d33',
                            confirmButtonText: 'ปิด',
                            allowOutsideClick: false,
                            focusConfirm: false,
                        });
                    }

                },
                error: function (xhr, status, error) {
                    console.error("อัพโหลดล้มเหลว:", error);
                }
            });
        } else {
            alert("กรุณาเลือกไฟล์ก่อน");
        }
    }

</script>



