        <!-- Info Panel -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-white border-bottom header-fix">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="mb-0">Info</h5>
                            <div id="truBadges"></div>
                        </div>
                        <div id="addTru"></div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="truList">
                        <!-- Engine items will be inserted here -->
                    </div>
                </div>
            </div>
        </div>



        <!-- Modal -->
        <!--Modal Only Text-->
        <div class="modal fade" id="entityModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-3 shadow-lg">
                    <!-- Header -->
                    <div class="modal-header bg-light">
                        <h5 class="modal-title fw-bold" id="entityModalTitle">Add Item</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <!-- Body -->
                    <div class="modal-body">
                        <input type="hidden" id="entityType"> <!-- MarketSegment / VehicleSegment / Maker / ModelRange / Model -->
                        <input type="hidden" id="entityId">   <!-- ใช้เวลา Edit -->
                        <input type="hidden" id="marketSegId">   <!-- ใช้เวลา Edit Model-->
                        <input type="hidden" id="makerId">   <!-- ใช้เวลา Edit Model-->
                        <input type="hidden" id="rangeId">   <!-- ใช้เวลา Edit Model-->
                        <div class="mb-3">
                            <label for="entityInput" class="form-label" id="entityInputLabel">Name</label>
                            <input type="text" class="form-control" id="entityInput" placeholder="กรอกข้อมูล">
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="modal-footer d-flex align-items-end">
                        <button type="button" class="btn btn-success px-4" id="saveEntityBtn">
                            <i class="fa fa-plus me-1"></i> Add
                        </button>
                        <button type="button" class="btn btn-danger px-4" data-bs-dismiss="modal">
                            <i class="fa fa-times me-1"></i> Close
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!--Body Modal-->
        <div class="modal fade" id="bodyModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-3 shadow-lg">
                    <!-- Header -->
                    <div class="modal-header bg-light">
                        <h5 class="modal-title fw-bold" id="bodyModalTitle">Add Body</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <!-- Body -->
                    <div class="modal-body">
                        <input type="hidden" id="bodyId"> <!-- ใช้เก็บ id เวลาแก้ไข -->
                        <div class="mb-3">
                            <div class="add-section">
                                <div class="row g-2 mb-2">
                                    <div class="col-12">
                                        <label class="text-muted-small mb-1 d-block">Body</label>
                                        <input type="text" class="form-control form-control-sm" id="bodycod-txt" placeholder="Body">
                                    </div>
                                </div>
                                <div class="row g-2">
                                    <div class="col">
                                        <label class="text-muted-small mb-1 d-block">Body Type</label>
                                        @*<input type="text" class="form-control form-control-sm" id="bodytype-txt" placeholder="Body type">*@
                                        <select class="form-select" id="bodytype-txt">
                                            <option value="" selected>NA</option>
                                            <option value="Off-road vehicle open">Off-road vehicle open</option>
                                            <option value="Pickup">Pickup</option>
                                            <option value="Liftback">Liftback</option>
                                            <option value="Spoon">Spoon</option>
                                            <option value="Cabrio">Cabrio</option>
                                            <option value="Chassis">Chassis</option>
                                            <option value="Estate">Estate</option>
                                            <option value="Convertible">Convertible</option>
                                            <option value="Targa">Targa</option>
                                            <option value="MPV">MPV</option>
                                            <option value="Saloon">Saloon</option>
                                            <option value="Off-road vehicle closed">Off-road vehicle closed</option>
                                            <option value="Van / Box">Van / Box</option>
                                            <option value="Van / Estate">Van / Estate</option>
                                            <option value="Coach">Coach</option>
                                            <option value="Coupe">Coupe</option>
                                            <option value="Hatchback">Hatchback</option>
                                            <option value="KTP">KTP</option>
                                            <option value="SUV">SUV</option>
                                        </select>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="modal-footer d-flex align-items-end">
                        <button type="button" class="btn btn-success px-4" id="saveBodyBtn">
                            <i class="fa fa-plus me-1"></i> ADD
                        </button>
                        <button type="button" class="btn btn-danger px-4" data-bs-dismiss="modal">
                            <i class="fa fa-times me-1"></i> Close
                        </button>
                    </div>
                </div>
            </div>
        </div>


        <!--Engine Modal-->
        <div class="modal fade" id="engineModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-3 shadow-lg">
                    <!-- Header -->
                    <div class="modal-header bg-light">
                        <h5 class="modal-title fw-bold" id="engineModalTitle">ADD Engine</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <!-- Body -->
                    <div class="modal-body">
                        <input type="hidden" id="engineId"> <!-- ใช้เก็บ id เวลาแก้ไข -->
