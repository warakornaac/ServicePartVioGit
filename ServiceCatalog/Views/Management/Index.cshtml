                                icon: 'error',
                                title: 'Error',
                                text: data.message,
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'ปิด',
                                allowOutsideClick: false,
                                focusConfirm: false,
                            });
                            return false;
                        }
                    }
                });//end ajax
            }//end condition
            Swal.fire({
                title: "ยืนยัน?",
                text: "ต้องการดำเนินการต่อหรือไม่",
                icon: "question",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "ใช่",
                cancelButtonText: "ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    editTrudata(_marketSeg, _vehicleSeg, maker, rang, model, body, eng, xktype, xdrive, xyearfrom, xyearto, xthvio, xtrutyp);
