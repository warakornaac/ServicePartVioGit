                        <input type="hidden" id="tru_makerId"> <!-- ใช้เก็บ id เวลาแก้ไข -->
                        <input type="hidden" id="tru_rangeId"> <!-- ใช้เก็บ id เวลาแก้ไข -->
                        <input type="hidden" id="tru_modelId"> <!-- ใช้เก็บ id เวลาแก้ไข -->
                        <input type="hidden" id="tru_bodyId"> <!-- ใช้เก็บ id เวลาแก้ไข -->
                        <input type="hidden" id="tru_engineId"> <!-- ใช้เก็บ id เวลาแก้ไข -->
                        <input type="hidden" id="tru_trutype"> <!-- ใช้เก็บ id เวลาแก้ไข -->
                        <div class="mb-3">
                            <div class="editable-group">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="fw-medium text-dark" id="span-tru"></span>
                                </div>
                                <div class="row">
                                    <div class="col-12">
                                        <label class="text-muted-small mb-1 d-block">KType</label>
                                        <input type="text" inputmode="numeric" pattern="[0-9]*" oninput="this.value = this.value.replace(/[^0-9]/g, '')" class="form-control form-control-sm" placeholder="KType" id="ktype-txt">
                                    </div>
                                    <div class="col-12">
                                        <label class="text-muted-small mb-1 d-block">DriveType</label>
                                        @*<input type="text" class="form-control form-control-sm" placeholder="DriveType" id="drive-txt">*@
                                        <select class="form-select" aria-label="DriveType" id="drive-txt">
                                            <option value="NA" selected>NA</option>
                                            <option value="FWD">FWD</option>
                                            <option value="AWD">AWD</option>
                                            <option value="RWD">RWD</option>
                                        </select>

                                    </div>
                                    <div class="col-6">
                                        <label class="text-muted-small mb-1 d-block">YearFrom</label>
                                        <input type="text" inputmode="numeric" pattern="[0-9]*" oninput="this.value = this.value.replace(/[^0-9]/g, '')" class="form-control form-control-sm" placeholder="YearFrom" id="yearfrom-txt">
                                    </div>
                                    <div class="col-6">
                                        <label class="text-muted-small mb-1 d-block">YearTo</label>
                                        <input type="text" inputmode="numeric" pattern="[0-9]*" oninput="this.value = this.value.replace(/[^0-9]/g, '')" class="form-control form-control-sm" placeholder="YearTo" id="yearto-txt">
                                    </div>
                                    <div class="col-12">
                                        <label class="text-muted-small mb-1 d-block">ThaiVIO</label>
                                        <input type="text" inputmode="numeric" pattern="[0-9]*" oninput="this.value = this.value.replace(/[^0-9]/g, '')" class="form-control form-control-sm" placeholder="ThaiVIO" id="thvio-txt">
                                    </div>
                                </div>
                                @*<div class="row mt-3">
                                        <div class="col-12">
                                            <label class="text-muted-small mb-1 d-block">TruType</label>
                                            <input type="text" class="form-control form-control-sm" placeholder="TruType" readonly>
                                        </div>
                                    </div>*@
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="modal-footer d-flex align-items-end">
                        <button type="button" class="btn btn-success px-4" id="saveTruBtn">
                            <i class="fa fa-plus me-1"></i> ADD
                        </button>
