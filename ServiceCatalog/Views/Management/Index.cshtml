        function MakerLoader() {
        $.ajax({
            url: '@Url.Action("GetVIO_Maker", "Management")',
            type: 'post',
            dataType: 'json',
            beforeSend: function () {
                //$('#makerList').html('');
                resetModel();
                resetBody();
                resetEngine();
                resetInfo();
            },
            success: function (data) {
                if (data.respone == true) {
                    console.log('PASS');
                    var pageString = '';
                    if (data.result.length > 0) {
                        for (var i = 0; i < data.result.length; i++) {
                                pageString += `
                                <div class = "item-row">
                                    @*<div class="color-dot color-dot-red"></div>*@
                                    <input type="radio" class="form-check-input custom-checkbox"
                                        name="maker-radio"
                                        id="maker-${data.result[i].ID}"
                                        onchange="toggleMaker('${data.result[i].ID}')">
                                        <label for="maker-${data.result[i].ID}">${data.result[i].Maker}</label>
                                        <div class="d-flex gap-2 ms-auto" data-makerid="${data.result[i].ID}" data-makername="${data.result[i].Maker}" >
                                           <button class="btn btn-warning btn-sm" onclick="openEntityModal('edit','Maker','3','${data.result[i].ID}','${data.result[i].Maker}')">
                                               <i class="fa fa-pencil-square-o"></i>
                                           </button>
                                           <button class="btn btn-danger btn-sm" onclick="deleteConf('Maker: ${data.result[i].Maker}','3','','','${data.result[i].ID}','','','','')">
                                               <i class="fa fa-trash-o"></i>
                                           </button>
                                       </div>
                                </div>`;
                        }
                        $('#makerList').html(pageString);

                    }
                }
                else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message,
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                if (jqXHR.status === 404) {
                    console.error("Resource not found.");
                } else if (textStatus === "timeout") {
                    console.error("Request timed out.");
                } else {
                    console.error("AJAX error: " + textStatus + " - " + errorThrown);
                    if (jqXHR.responseText) {
                        console.error("Server response: " + jqXHR.responseText);
                    }
                }
            }
        });
    }
