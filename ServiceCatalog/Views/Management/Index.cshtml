    function deleteConf(name, moduleId, marketId = '', vehicleId = '', makerId='', modelRangeId='', modelId='', bodyId='', engineId='') {
        $.ajax({
            url: '@Url.Action("CheckVIODataParent", "Management")',
            data: { moduleID: moduleId, marketSegID: marketId, vehicleSegID: vehicleId, makerID: makerId, rangeID: modelRangeId, modelID: modelId, bodyID: bodyId, engineID: engineId },
            type: 'post',
            dataType: 'json',
            beforeSend: function () {

            },
            success: function (data) {
                if (data.flag == 'N') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'เกิดข้อผิดพลาด',
                        html: data.message + '<br>' + name,
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                }
                else if (data.flag == 'Y') {
                    Swal.fire({
                        title: "ต้องการจะลบหรือไม่?",
                        text: name,
                        icon: "question",
                        showCancelButton: true,
                        confirmButtonColor: "#3085d6",
                        cancelButtonColor: "#d33",
                        confirmButtonText: "ลบ",
                        cancelButtonText: "ยกเลิก"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            deleteVIO(name, moduleId, marketId, vehicleId, makerId, modelRangeId, modelId, bodyId, engineId);
                        }
                    });
                }
                else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        html: data.message,
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                }
            }
        });
    }

    function deleteVIO(name,moduleId, marketId, vehicleId, makerId, modelRangeId, modelId, bodyId, engineId) {
        $.ajax({
            url: '@Url.Action("DeleteVIO_TruData", "Management")',
            data: { moduleID: moduleId, marketSegID: marketId, vehicleSegID: vehicleId, makerID: makerId, modelRangeID: modelRangeId, modelID: modelId, bodyID: bodyId, engineID: engineId },
            type: 'post',
            dataType: 'json',
            beforeSend: function () {

            },
            success: function (data) {
                if (data.respone === true) {
                    Swal.fire({
                        icon: 'success',
                        title: 'ลบ ' + name +' สำเร็จ!',
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    }).then(() => {
                        if (moduleId === '1') {
                            location.reload();
                        }
                        else if (moduleId === '2') {
                            location.reload();
                        }
                        else if (moduleId === '3') {
                            MakerLoader();
                        }
                        else if (moduleId === '4') {
                            modelLoader(marketId, makerId, modelRangeId);
                        }
                        else if (moduleId === '5') {
                            modelRangeLoader(makerId);
                        }
                        else if (moduleId === '6') {
                            bodyLoader(makerId, modelRangeId, modelId);
                        }
                        else if (moduleId === '7') {
                            engineLoader(makerId, modelRangeId, modelId, bodyId)
                        }
                        else if (moduleId === '8') {
                            trudataLoader(makerId, modelRangeId, modelId, bodyId, engineId)
                        }
                    });
                }
                else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message,
                        confirmButtonColor: '#d33',
                        confirmButtonText: 'ปิด',
                        allowOutsideClick: false,
                        focusConfirm: false,
                    });
                }//end else
            }
        })
    }



