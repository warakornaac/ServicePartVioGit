                                        <table class="table table-bordered table-sm text-nowrap">
                                            <thead>
                                                <tr>
                                                    <th>KType</th>
                                                    <th>MarketSegment</th>
                                                    <th>VehicleSegment</th>
                                                    <th>Maker</th>
                                                    <th>ModelRange</th>
                                                    <th>Model</th>
                                                    <th>Body</th>
                                                    <th>EngineType</th>
                                                    <th>DriveType</th>
                                                    <th>YearFrom</th>
                                                    <th>YearTo</th>
                                                    <th>TruType</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                    `;
                                if (data.result.length > 0) {
                                    data.result.forEach(item => {
                                        tableHtml += `
                                            <tr>
                                                <td>${item.KType || ''}</td>
                                                <td>${item.MarketSegment || ''}</td>
                                                <td>${item.VehicleSegment || ''}</td>
                                                <td>${item.Maker || ''}</td>
                                                <td>${item.ModelRange || ''}</td>
                                                <td>${item.Model || ''}</td>
                                                <td>${item.Body || ''}</td>
                                                <td>${item.EngineType || ''}</td>
                                                <td>${item.DriveType || ''}</td>
                                                <td>${item.YearFrom || ''}</td>
                                                <td>${item.YearTo || ''}</td>
                                                <td>${item.TruType || ''}</td>

                                            </tr>
                                        `;
                                    });//endloop
                                    tableHtml += `
                                              </tbody>
                                            </table>
                                        `;
                                }
                                Swal.fire({
                                    icon: 'warning',
                                    title: 'เพิ่มข้อมูลผิดพลาด',
                                    html: 'ตรวจพบ K-type ซ้ำกับรายการ <br>' + `<div class="table-responsive" style="max-height:300px; overflow-y:auto;">${tableHtml}</div>`,
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'ปิด',
                                    allowOutsideClick: false,
                                    focusConfirm: false,
                                    width: '700px',
                                    customClass: {
                                        popup: 'swal-wide'
                                    }
