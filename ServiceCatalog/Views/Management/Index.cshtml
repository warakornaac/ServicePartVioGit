
@{
    ViewBag.Title = "Index";
}


<style>
    .color-dot {
        width: 8px;
        height: 8px;
        border-radius: 2px;
        display: inline-block;
    }

    .color-dot-red {
        background-color: #dc3545;
    }

    .color-dot-blue {
        background-color: #0d6efd;
    }

    .editable-group {
        background-color: #f8f9fa;
        border-radius: 0.375rem;
        padding: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .select-all-indicator {
        width: 12px;
        height: 12px;
        background-color: #0d6efd;
        border-radius: 2px;
        display: inline-block;
    }

    .help-circle {
        width: 24px;
        height: 24px;
        background-color: #0d6efd;
        color: white;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }

    .step-circle {
        width: 24px;
        height: 24px;
        background-color: #0d6efd;
        color: white;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }

    .brand-badge {
        background-color: #dc3545;
        color: white;
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 4px;
    }

    .model-badge {
        background-color: #6c757d;
        color: white;
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 4px;
    }

    .custom-checkbox {
        width: 16px;
        height: 16px;
    }

    .model-code-section {
        background-color: #f8f9fa;
        padding: 12px;
        border-radius: 6px;
        margin-bottom: 12px;
    }

    .edit-icon {
        color: #6c757d;
        font-size: 14px;
        cursor: pointer;
    }

    .add-btn {
        background-color: #198754;
        border-color: #198754;
        font-size: 12px;
        padding: 6px 12px;
    }

        .add-btn:hover {
            background-color: #157347;
            border-color: #146c43;
        }

    .small-text {
        font-size: 11px;
    }

    .card-header h5 {
        font-size: 16px;
        margin: 0;
    }

    .card {
        max-height: 440px;
        overflow: auto;
    }

    .header-fix {
        position: sticky;
        top: 0;
    }

    .item-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    .bg-input-list {
        background-color: #FAFAFA;
    }

    .item-row label {
        flex: 1;
        margin: 0;
        cursor: pointer;
        font-size: 13px;
    }

    .item-row:hover {
        cursor: pointer;
    }

    .editable-group:hover {
        cursor: pointer;
    }


    @@keyframes shake {
        0% {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-5px);
        }

        50% {
            transform: translateX(5px);
        }

        75% {
            transform: translateX(-5px);
        }

        100% {
            transform: translateX(0);
        }
    }

    .is-invalid {
        border: 2px solid red !important;
        animation: shake 0.3s;
    }



    .swal-wide {
        max-width: 1000px !important; /* ปรับได้ตามต้องการ */
    }

    .swal2-html-container {
        max-height: 70vh; /* ไม่ให้ยาวเกินจอ */
        overflow-y: auto; /* เลื่อนลงได้ */
    }

        .swal2-html-container table {
            width: 100% !important; /* table เต็มพื้นที่ */
            font-size: 13px; /* ปรับฟอนต์เล็กลงนิดนึง */
        }
</style>

<div class="page-header">
    <h1 class="page-title my-auto">Management VIO</h1>
    <div>
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index","Home")">Home</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Management VIO</li>
        </ol>
    </div>
</div>
<div class="container-fluid py-4">
    @*<div class="row">
            <div class="col-12">
                <h2 class="mb-4 text-dark">Management VIO Data</h2>
            </div>
        </div>*@
    <div class="row mb-3">
        <div class="col-lg-6 ">
            <div class="card h-100">
                <div class="card-header bg-white border-bottom">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                        <h5 class="mb-0">Market Segment</h5>
                        <div class="d-flex gap-2 mt-3">
                            <button type="button" class="btn btn-success add-btn" onclick="openEntityModal('add','Market Segment','1')">ADD</button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="marketsegList">
                        @if (ViewBag.MarketSeg != null)
                        {
                            if (Enumerable.Count(ViewBag.MarketSeg) > 0)
                            {
                                int i = 0;
                                foreach (var item in ViewBag.MarketSeg)
                                {
                                    i++;
                                    <div class="item-row">
                                        @*<div class="color-dot color-dot-red"></div>*@
                                        <input type="radio" class="form-check-input custom-checkbox"
                                               name="MarketSeg"
                                               id="Market-@item.ID"
                                               value="@item.ID"
                                               @(i == 1 ? "checked" : null)
                                               onchange="toggleParent()">
                                        <label for="Market-@item.ID">@item.MarketSegment</label>

                                        <div class="d-flex gap-2 ms-auto" data-marketid="@item.ID" data-marketname="@item.MarketSegment">
                                            <button class="btn btn-warning btn-sm" onclick="openEntityModal('edit','Market Segment','1','@item.ID','@item.MarketSegment')">
                                                <i class="fa fa-pencil-square-o"></i>
                                            </button>
                                            <button class="btn btn-danger btn-sm" onclick="deleteConf('Market Segment: @item.MarketSegment','1','@item.ID','','','','','','')">
                                                <i class="fa fa-trash-o"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div>
                                <h6>
                                    ไม่พบข้อมูล / No Data
                                </h6>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-white border-bottom">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                        <h5 class="mb-0">Vehicle Segment</h5>
                        <div class="d-flex gap-2 mt-3">
                            <button type="button" class="btn btn-success add-btn" onclick="openEntityModal('add','Vehicle Segment','2')">ADD</button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="vehiclesegList">
                        @if (ViewBag.VehicleSeg != null)
                        {
                            if (Enumerable.Count(ViewBag.VehicleSeg) > 0)
                            {
                                int j = 0;
                                foreach (var item in ViewBag.VehicleSeg)
                                {
                                    j++;
                                    <div class="item-row">
                                        @*<div class="color-dot color-dot-red"></div>*@
                                        <input type="radio" class="form-check-input custom-checkbox"
                                               name="VehicleSeg"
                                               id="vehicle-@item.ID"
                                               value="@item.ID"
                                               @(j == 1 ? "checked" : null)
                                               onchange="toggleParent()">

                                        <label for="vehicle-@item.ID">@item.VehicleSegment</label>
                                        <div class="d-flex gap-2 ms-auto" data-marketid="@item.ID" data-marketname="@item.VehicleSegment">
                                            <button class="btn btn-warning btn-sm" onclick="openEntityModal('edit','Vehicle Segment','2','@item.ID','@item.VehicleSegment')">
                                                <i class="fa fa-pencil-square-o"></i>
                                            </button>
                                            <button class="btn btn-danger btn-sm" onclick="deleteConf('Vehicle Segment: @item.VehicleSegment','2','','@item.ID','','','','','')">
                                                <i class="fa fa-trash-o"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div>
                                <h6>
                                    ไม่พบข้อมูล / No Data
                                </h6>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
    <div class="row g-4">
        <!-- Maker Panel -->
        <div class="col-lg-3">
            <div class="card h-100">
                <div class="card-header bg-white border-bottom header-fix">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                        <h5 class="mb-0">Maker</h5>
                        @*<div class="help-circle">?</div>*@
                        <div class="d-flex gap-1 ">
                            <button type="button" class="btn btn-success add-btn" onclick="openEntityModal('add','Maker','3')">ADD</button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="makerList">
                        <!-- Maker items will be inserted here -->
                    </div>

                    @*<div class="d-flex gap-2 mt-3">
                            <input type="text" class="form-control form-control-sm" id="newMakerInput" placeholder="กรอกข้อมูล">
                            <button type="button" class="btn btn-success add-btn" onclick="openEntityModal('add','Maker')">Add</button>
                        </div>*@
                </div>
            </div>
        </div>
        <!-- Model Rang Data -->
        <div class="col-lg-3">
            <div class="card h-100">
                <div class="card-header bg-white border-bottom">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="mb-0">Model Range</h5>
                            <div id="modelRaBadges"></div>
                        </div>
                        <div id="addModelRange"></div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="modelRangeList">
                    </div>

                </div>
            </div>
        </div>
        <!-- Model Panel -->
        <div class="col-lg-3">
            <div class="card h-100">
                <div class="card-header bg-white border-bottom header-fix">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="mb-0">Model</h5>
                            <div id="modelMakerBadges"></div>
                        </div>
                        <div id="addModel"></div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="modelList">
                    </div>

                </div>
            </div>
        </div>

        <!-- Body Data-->
        <div class="col-lg-3">
            <div class="card h-100">
                <div class="card-header bg-white border-bottom header-fix">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="mb-0">Body</h5>
                            <div id="bodyBadges"></div>
                        </div>
                        <div id="addBody"></div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="bodyList"></div>

                </div>
            </div>
        </div>

        <!-- Engine Panel -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-white border-bottom header-fix">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="mb-0">Engine</h5>
                            <div id="engineBadges"></div>
                        </div>
                        <div id="addEngine"></div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="engineList">
                        <!-- Engine items will be inserted here -->
                    </div>
                </div>
            </div>
