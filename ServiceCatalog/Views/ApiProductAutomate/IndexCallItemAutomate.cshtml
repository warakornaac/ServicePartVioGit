@*List Item*@
<div class="row">
    <div class="col-xl-12">
        <div class="card custom-card">
            <div class="card-body p-0">
                <div class="d-flex p-3 align-items-center justify-content-between">
                    <div>
                        <h6 class="fw-semibold mb-0">รายการ Item วันนี้ <span class="badge bg-secondary fs-15">@currentDate</span> </h6>
                    </div>
                    <div>
                        <ul class="nav nav-tabs nav-tabs-header mb-0 d-sm-flex d-block" role="tablist">
                            <li class="nav-item m-1">
                                <a class="nav-link position-relative active" data-bs-toggle="tab" role="tab" aria-current="page" href="#pending" aria-selected="true">
                                    Pending
                                    <span class="badge bg-secondary rounded-pill position-absolute top-0 start-100 translate-middle fs-15" id="cart-icon-badge"><div id="sumItemCurrentTaskPendding">0</div></span>
                                </a>
                            </li>
                            <li class="nav-item m-1">
                                <a class="nav-link position-relative" data-bs-toggle="tab" role="tab" aria-current="page" href="#in-progress" aria-selected="true">
                                    In Progress
                                    <span class="badge bg-warning rounded-pill position-absolute top-0 start-100 translate-middle fs-15" id="cart-icon-badge sumItemCurrentTaskProcess"><div id="sumItemCurrentTaskProcess">0</div></span>
                                </a>
                            </li>
                            <li class="nav-item m-1">
                                <a class="nav-link position-relative" data-bs-toggle="tab" role="tab" aria-current="page" href="#completed" aria-selected="true">
                                    Completed
                                    <span class="badge bg-success rounded-pill position-absolute top-0 start-100 translate-middle fs-15" id="cart-icon-badge sumItemCurrentTaskComplete"><div id="sumItemCurrentTaskComplete">0</div></span>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="prism-toggle">
                        <div class="text-sm-center"> <p class="fs-14 fw-semibold mb-0">RowCall</p><span class="badge bg-danger fs-11 rounded-1" id="txtResNumberRandom">0</span> </div>
                    </div>
                    <div>
                        <!-- Create Task Button -->
                        <div class="">
                            <button type="button" class="btn btn-primary" onclick="runTaskCallApi();" id="btnRunTask">
                                <i class="ri-play-mini-fill fs-16 align-middle me-1"></i> Run Task
                            </button>
                            <button type="button" class="btn btn-danger" onclick="stopTaskCallApi();" id="btnStopTask">
                                <i class="ri-stop-mini-fill fs-16 align-middle me-1"></i> Stop Task
                            </button>
                        </div>
                        <!-- Modal -->
                        <div class="modal fade" id="addtask" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <!-- Modal Header -->
                                    <div class="modal-header">
                                        <h6 class="modal-title" id="mail-ComposeLabel">Run Task</h6>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <!-- Modal Body -->
                                    <div class="modal-body px-4">
                                        <div class="row gy-2">
                                            <!-- Task Name -->
                                            <div class="col-xl-12">
                                                <label for="task-name" class="form-label">Task Date</label>
                                                <input type="text" class="form-control" id="task-name" placeholder="Task Date">
                                            </div>
                                            <div class="col-xl-12">
                                                <label class="form-label">Number</label>
                                                <div class="choices" data-type="select-one" tabindex="0" role="combobox" aria-autocomplete="list" aria-haspopup="true" aria-expanded="false">
                                                    <div class="choices__inner">
                                                        <select class="form-control choices__input" name="choices-single-default" id="choices-single-default" hidden tabindex="-1" data-choice="active">
                                                            <option value="">Select</option>
                                                        </select>
                                                        <div class="choices__list choices__list--single">
                                                            <div class="choices__item choices__placeholder choices__item--selectable" data-id="1" data-value="" aria-selected="true">Select</div>
                                                        </div>
                                                    </div>

                                                    <!-- Priority Dropdown -->
                                                    <div class="choices__list choices__list--dropdown" aria-expanded="false">
                                                        <input type="text" class="choices__input choices__input--cloned" autocomplete="off" role="textbox" aria-autocomplete="list" placeholder="Search">
                                                        <div class="choices__list" role="listbox">
                                                            <div class="choices__item choices__item--choice is-selected choices__placeholder is-highlighted" data-id="5" data-value="" role="option" aria-selected="true">Select</div>
                                                            <div class="choices__item choices__item--choice" data-id="1" data-value="Critical" role="option">Critical</div>
                                                            <div class="choices__item choices__item--choice" data-id="2" data-value="High" role="option">High</div>
                                                            <div class="choices__item choices__item--choice" data-id="3" data-value="Low" role="option">Low</div>
                                                            <div class="choices__item choices__item--choice" data-id="4" data-value="Medium" role="option">Medium</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div> <!-- End of row -->
                                    </div> <!-- End of modal-body -->
                                    <!-- Modal Footer -->
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                        <button type="button" class="btn btn-primary" onclick="runTaskCallApi();">Run</button>
                                    </div>

                                </div> <!-- End of modal-content -->
                            </div> <!-- End of modal-dialog -->
                        </div> <!-- End of modal -->
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xxl-2 col-md-3 task-card">
                <input type="hidden" name="resNumberStart" id="resNumberStart" class="form-control" placeholder="NumberStart">
                <input type="hidden" name="resNnumberEnd" id="resNnumberEnd" class="form-control" placeholder="NumberEnd">
                <input type="hidden" name="resNumberRandom" id="resNumberRandom" class="form-control" placeholder="numberResult">
            </div>
        </div>
    </div>
    <div class="tab-content task-tabs-container">
        @*<div class="tab-pane show active p-0" id="all-tasks" role="tabpanel"> </div>*@
        <div class="tab-pane show active p-0" id="pending" role="tabpanel"> </div>
        <div class="tab-pane p-0" id="in-progress" role="tabpanel"> </div>
        <div class="tab-pane p-0" id="completed" role="tabpanel"> </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="itemProductDeatilModal" tabindex="-1" aria-labelledby="ModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header pb-2">
                <h4 class="modal-title" id="ModalLabel">รายละเอียด</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Dynamic content will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                    <i class="fa fa-times"></i> ปิด
                </button>
            </div>
        </div>
    </div>
</div>

<script defer>
    //get first all task
    if (document.readyState == "loading") {
        setTimeout(function () {
            GetListItemAutomateByStatus("", "", "", "0", "pending");
            GetProductApiAutomateCount();
            //ปิดปุ่ม stop
            $("#btnStopTask").prop("disabled", true);
        }, 1000);
    }
    //ดึง list task
    function GetListItemAutomateByStatus(Stkcode, BrandId, apiStatus, RowNumber, nameTask) {
        $.ajax({
            type: 'post',
            url: '@Url.Action("GetListItemAutomate", "ApiProductAutomate")',
            data: {
                Stkcode: "",
                BrandId: "",
                ApiStatus: apiStatus,
                RowNumber: RowNumber

            },
            dataType: 'html',
            beforeSend: function () {
                $('#' + nameTask).empty();
                $('#' + nameTask).html('<div style="padding: 30px; font-size: 14px;"> <i class="fa fa-spinner fa-spin fa-2x" aria-hidden="true"></i> กำลังโหลดข้อมูล... </div>');
                // LoadingShow();
            },
            success: function (res) {
                // LoadingHide();
                $('#' + nameTask).html(res);
            },
            error: function (er) {
                alert(er.error);
            }
        }).fail(function (error) {
            Swal.fire({
                icon: 'error',
                title: error.status,
                html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>GetListItemAutomateByStatus<br><br>',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false,
            });
        });
    }
    //click link tab
    $('a[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
        var targetTab = $(e.target).attr("href");
        console.log("Tab clicked: " + targetTab);
        switch (targetTab) {
            case "#pending":
                GetListItemAutomateByStatus("", "", "", "0", "pending");
                break;
            case "#in-progress":
                GetListItemAutomateByStatus("", "", "D", "0", "in-progress");
                break;
            case "#completed":
                GetListItemAutomateByStatus("", "", "Y", "0", "completed");
                break;
        }
    });
    //count item
    async function GetProductApiAutomateCount() {
        console.log("GetProductApiAutomateCount");
        try {
            $.ajax({
                type: 'post',
                url: '@Url.Action("GetProductApiAutomateCount", "ApiProductAutomate")',
                data: {},
                dataType: 'json',
                success: function (data) {
                    $('#sumItemAll').text(Number(data[0].sumItemAll).toLocaleString());
                    $('#sumItemAllSuccess').text(Number(data[0].sumItemAllSuccess).toLocaleString());
                    $('#sumItemCurrentAll').text(Number(data[0].sumItemCurrentAll).toLocaleString());
                    $('#sumItemCurrentAllSuccess').text(Number(data[0].sumItemCurrentAllSuccess).toLocaleString());
                    $('#sumItemCurrentTaskPendding').text(Number(data[0].sumItemCurrentTaskPendding).toLocaleString());
                    $('#sumItemCurrentTaskProcess').text(Number(data[0].sumItemCurrentTaskProcess).toLocaleString());
                    $('#sumItemCurrentTaskComplete').text(Number(data[0].sumItemCurrentTaskComplete).toLocaleString());
                }
            }).fail(function (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'ระบบทำงานผิดพลาด()',
                    html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>GetProductApiAutomateCount<br>' + error.responseText + '<br><br>',
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'ปิด',
                    allowOutsideClick: false,
                    focusConfirm: false
                });
            });
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'ระบบทำงานผิดพลาด()',
                html: 'กรุณาแจ้งผู้ดูแลระบบ<br>โดยการแคปหน้าจอและก๊อปปี้ Error ด่านล่างนี้<br>GetProductApiAutomateCount<br>' + erroพ + '<br><br>',
                confirmButtonColor: '#d33',
                confirmButtonText: 'ปิด',
                allowOutsideClick: false,
                focusConfirm: false
            });
        }
    }

</script>
